<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CoffeeNap</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../CoffeeNap/Data/*.cs" Link="Data/%(Filename)%(Extension)" />
    <Compile Include="../../CoffeeNap/Models/*.cs" Exclude="../../CoffeeNap/Models/NavigationTab.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../../CoffeeNap/Models/AddConsumption/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../../CoffeeNap/Models/Calendar/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../../CoffeeNap/Services/Persistence/*.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../../CoffeeNap/Services/Statistics/*.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../../CoffeeNap/Services/Consumption/*.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../../CoffeeNap/Services/Localization/LocalizationService.cs" Link="Services/LocalizationService.cs" />
    <Compile Include="../../CoffeeNap/Services/Lifecycle/LocalCalendarTime.cs" Link="Services/LocalCalendarTime.cs" />
    <Compile Include="../../CoffeeNap/Services/Dialogs/IDialogService.cs" Link="Services/IDialogService.cs" />
    <Compile Include="../../CoffeeNap/ViewModels/MainPageViewModel.cs" Link="ViewModels/MainPageViewModel.cs" />
    <Compile Include="../../CoffeeNap/ViewModels/CalendarPageViewModel.cs" Link="ViewModels/CalendarPageViewModel.cs" />
    <Compile Include="../../CoffeeNap/ViewModels/ConsumptionItemViewModel.cs" Link="ViewModels/ConsumptionItemViewModel.cs" />
    <Compile Include="../../CoffeeNap/ViewModels/CaffeineSourceStatViewModel.cs" Link="ViewModels/CaffeineSourceStatViewModel.cs" />
    <Compile Include="../../CoffeeNap/Helpers/Caffeine*ColorProvider.cs" Link="Helpers/%(Filename)%(Extension)" />
    <Compile Include="../../CoffeeNap/Helpers/RelativeTimeFormatter.cs" Link="Helpers/RelativeTimeFormatter.cs" />
    <Compile Include="../../CoffeeNap/Helpers/PagedObservableCollection.cs" Link="Helpers/PagedObservableCollection.cs" />
    <EmbeddedResource Include="../../CoffeeNap/Resources/Localization/AppResources.resx" ManifestResourceName="CoffeeNap.Resources.Localization.AppResources" />
    <EmbeddedResource Include="../../CoffeeNap/Resources/Localization/AppResources.en.resx" ManifestResourceName="CoffeeNap.Resources.Localization.AppResources.en" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
</Project>
