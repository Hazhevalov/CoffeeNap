<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CoffeeNap.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CoffeeNap"
    Title="CoffeeNap"
    Shell.TabBarForegroundColor="#000"
    Shell.TabBarUnselectedColor="#AAAAAA"
    Shell.TitleColor="#000"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <!--
        Shell используется как навигационный стек без видимых flyout и tab bar.
        MainPage — единственный корневой маршрут; остальные регистрируются в code-behind.
    -->
    <ShellContent
        Route="MainPage"
        ContentTemplate="{DataTemplate local:MainPage}" />

</Shell>
