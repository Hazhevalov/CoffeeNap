<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CoffeeNap.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="CoffeeNap"
    Shell.TabBarForegroundColor="#000"
    Shell.TabBarUnselectedColor="#AAAAAA"
    Shell.TitleColor="#000"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <!-- Root items are hidden from the UI; select one before showing the first window. -->
    <FlyoutItem
        x:Name="OnboardingShellItem"
        Route="OnboardingPage">
        <ShellContent
            x:Name="OnboardingShellContent"
            Route="OnboardingContent" />
    </FlyoutItem>

    <FlyoutItem
        x:Name="MainShellItem"
        Route="AppTabs">
        <ShellContent
            x:Name="TabHostShellContent"
            Route="MainPage" />
    </FlyoutItem>

</Shell>
