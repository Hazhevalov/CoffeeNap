<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CoffeeNap.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CoffeeNap"
    Title="CoffeeNap"
    Shell.TabBarForegroundColor="#000"
    Shell.TabBarUnselectedColor="#AAAAAA"
    Shell.TitleColor="#000"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <!-- Корневые элементы скрыты от UI; нужный выбирается до показа первого окна. -->
    <FlyoutItem
        x:Name="WelcomeShellItem"
        Route="WelcomeRoot">
        <ShellContent
            Route="WelcomeContent"
            ContentTemplate="{DataTemplate local:WelcomePage}" />
    </FlyoutItem>

    <!-- Используется только для восстановления состояния «флаг есть, имени нет». -->
    <FlyoutItem
        x:Name="NameRecoveryShellItem"
        Route="NameRecoveryRoot">
        <ShellContent
            Route="NameRecoveryContent"
            ContentTemplate="{DataTemplate local:NameSetupPage}" />
    </FlyoutItem>

    <FlyoutItem
        x:Name="MainShellItem"
        Route="MainPage">
        <ShellContent
            Route="MainContent"
            ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>

</Shell>
