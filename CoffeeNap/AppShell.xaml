<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CoffeeNap.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CoffeeNap"
    Title="CoffeeNap"
    Shell.TabBarForegroundColor="#000"
    Shell.TabBarUnselectedColor="#AAAAAA"
    Shell.TitleColor="#000"
    Shell.TabBarIsVisible="False">

    <TabBar>
        <Tab Title="Home" Icon="home_ico.png">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
        </Tab>

        <Tab Title="Add Drink" Icon="add_ico.png">
            <ShellContent ContentTemplate="{DataTemplate local:SecondPage}" />
        </Tab>
    </TabBar>

</Shell>
