<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CoffeeNap.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:CoffeeNap.Behaviors"
    xmlns:controls="clr-namespace:CoffeeNap.Controls"
    xmlns:localization="clr-namespace:CoffeeNap.Resources.Localization"
    xmlns:viewModels="clr-namespace:CoffeeNap.ViewModels"
    x:DataType="viewModels:SettingsPageViewModel"
    Title="{localization:Translate SettingsTitle}"
    BackgroundColor="{StaticResource SurfaceColor}"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <!-- Редкие overlay инстанцируются только при первом показе. -->
        <DataTemplate x:Key="LanguageMenuTemplate" x:DataType="viewModels:SettingsPageViewModel">
            <Grid RowDefinitions="36,Auto">
                <Grid BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleLanguagePanelCommand}" />
                    </Grid.GestureRecognizers>
                    <BoxView BackgroundColor="{StaticResource InkColor}" CornerRadius="2" HeightRequest="4" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="42" />
                </Grid>
                <VerticalStackLayout Grid.Row="1" Padding="10" Spacing="10">
                    <Border Padding="20" Stroke="{StaticResource EnergyDrinkIcoFill}" StrokeShape="RoundRectangle 20">
                        <Border.Behaviors>
                            <behaviors:PressAnimationBehavior />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangeLanguageCommand}" CommandParameter="ru" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsRussianSelected}" Value="False">
                                <Setter Property="Stroke" Value="{StaticResource DividerColor}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image HeightRequest="24" Source="russian_ico.png" WidthRequest="24" />
                            <Label Grid.Column="1" FontAttributes="Bold" FontSize="16" Text="{localization:Translate Russian}" TextColor="{StaticResource InkColor}" />
                        </Grid>
                    </Border>
                    <Border Padding="20" Stroke="{StaticResource DividerColor}" StrokeShape="RoundRectangle 20">
                        <Border.Behaviors>
                            <behaviors:PressAnimationBehavior />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangeLanguageCommand}" CommandParameter="en" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsEnglishSelected}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource EnergyDrinkIcoFill}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image HeightRequest="24" Source="english_ico.png" WidthRequest="24" />
                            <Label Grid.Column="1" FontAttributes="Bold" FontSize="16" Text="{localization:Translate English}" TextColor="{StaticResource InkColor}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DeleteWarningTemplate" x:DataType="viewModels:SettingsPageViewModel">
            <VerticalStackLayout Spacing="20">
                <VerticalStackLayout Spacing="0">
                    <Label FontAttributes="Bold" FontSize="20" HorizontalTextAlignment="Center" Text="{localization:Translate Attention}" TextColor="{StaticResource InkColor}" />
                    <Label FontSize="16" HorizontalTextAlignment="Center" Text="{localization:Translate DeleteConfirmation}" TextColor="{StaticResource InkColor}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="10">
                    <Border BackgroundColor="#FFECEC" HorizontalOptions="Fill" MinimumHeightRequest="48" Padding="16,20" Stroke="#FFC8C8" StrokeShape="RoundRectangle 20" StrokeThickness="1">
                        <Border.Behaviors>
                            <behaviors:PressAnimationBehavior />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ConfirmDeleteCommand}" />
                        </Border.GestureRecognizers>
                        <Label FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" Text="{localization:Translate DeleteData}" TextColor="{StaticResource ValidationErrorColor}" />
                    </Border>
                    <Border BackgroundColor="{StaticResource White}" HorizontalOptions="Fill" MinimumHeightRequest="48" Padding="16,20" Stroke="{StaticResource DividerColor}" StrokeShape="RoundRectangle 20" StrokeThickness="1">
                        <Border.Behaviors>
                            <behaviors:PressAnimationBehavior />
                        </Border.Behaviors>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CancelDeleteCommand}" />
                        </Border.GestureRecognizers>
                        <Label FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" Text="{localization:Translate Cancel}" TextColor="{StaticResource InkColor}" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid Padding="12,0" RowDefinitions="Auto,*,Auto" RowSpacing="20">
        <Border Padding="10" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}" StrokeShape="RoundRectangle 300" StrokeThickness="1">
            <Grid ColumnDefinitions="54,*,54" ColumnSpacing="12">
                <Button Grid.Column="0" Padding="15" BackgroundColor="{StaticResource SurfaceColor}" Command="{Binding BackCommand}" CornerRadius="15" HeightRequest="54" ImageSource="back_ico.png" WidthRequest="54">
                    <Button.Behaviors>
                        <behaviors:PressAnimationBehavior PressedScale="0.96" />
                    </Button.Behaviors>
                </Button>
                <Label Grid.Column="1" FontAttributes="Bold" FontFamily="Inter" FontSize="18" HorizontalTextAlignment="Center" Text="{localization:Translate SettingsTitle}" TextColor="{StaticResource InkColor}" VerticalTextAlignment="Center" />
            </Grid>
        </Border>

        <VerticalStackLayout Grid.Row="1" Spacing="10">
            <Border Padding="20" Stroke="{StaticResource DividerColor}" StrokeShape="RoundRectangle 20">
                <Border.Behaviors>
                    <behaviors:PressAnimationBehavior />
                </Border.Behaviors>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleLanguagePanelCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,*">
                    <Label FontAttributes="Bold" FontSize="16" Text="{localization:Translate Language}" TextColor="{StaticResource InkColor}" />
                    <Label Grid.Column="1" FontSize="16" HorizontalTextAlignment="End" Text="{Binding CurrentLanguageDisplayName}" TextColor="{StaticResource MutedTextColor}" />
                </Grid>
            </Border>

            <Border Padding="20" Stroke="{StaticResource DividerColor}" StrokeShape="RoundRectangle 20">
                <Border.Behaviors>
                    <behaviors:PressAnimationBehavior />
                </Border.Behaviors>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenPrivacyPolicyCommand}" />
                </Border.GestureRecognizers>
                <Label FontAttributes="Bold" FontSize="15" Text="{localization:Translate PrivacyPolicy}" TextColor="{StaticResource InkColor}" />
            </Border>

            <Border Padding="20" Stroke="{StaticResource DividerColor}" StrokeShape="RoundRectangle 20">
                <Border.Behaviors>
                    <behaviors:PressAnimationBehavior />
                </Border.Behaviors>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding DeleteDataCommand}" />
                </Border.GestureRecognizers>
                <Label FontAttributes="Bold" FontSize="16" Text="{localization:Translate DeleteData}" TextColor="{StaticResource ValidationErrorColor}" />
            </Border>
        </VerticalStackLayout>

        <Border
            x:Name="LanguageMenu"
            Grid.Row="2"
            BackgroundColor="{StaticResource White}"
            IsVisible="False"
            Stroke="{StaticResource DividerColor}"
            StrokeShape="RoundRectangle 20"
            ZIndex="30" />

        <Border
            x:Name="DeleteWarning"
            Grid.Row="1"
            Padding="16,20"
            BackgroundColor="{StaticResource White}"
            IsVisible="False"
            StrokeShape="RoundRectangle 20"
            VerticalOptions="Center"
            ZIndex="20" />

        <controls:BottomNavigationBar
            x:Name="BottomNavigationBar"
            Grid.Row="2"
            BindingContext="{Binding Navigation}"
            HorizontalOptions="Center"
            IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IsNotDeletingData}"
            MinimumHeightRequest="78"
            SafeAreaEdges="Container"
            VerticalOptions="End"
            ZIndex="20" />
    </Grid>
</ContentPage>
