<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CoffeeNap.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CoffeeNap.Controls"
    xmlns:viewModels="clr-namespace:CoffeeNap.ViewModels"
    Title="Настройки"
    BackgroundColor="{StaticResource SurfaceColor}"
    Shell.NavBarIsVisible="False">

    <Grid Padding="10,0" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!--Список кнопок настроек-->
        <VerticalStackLayout Grid.Row="1" Spacing="10">
            <!--  Кнопка смены языка  -->
            <Border Padding="20" Stroke="{StaticResource DividerColor}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*,*">
                    <Label
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontSize="16"
                        HorizontalTextAlignment="Start"
                        Text="Язык"
                        TextColor="{StaticResource InkColor}" />

                    <Label
                        Grid.Column="1"
                        FontSize="16"
                        HorizontalTextAlignment="End"
                        Text="Русский"
                        TextColor="{StaticResource MutedTextColor}" />
                </Grid>
            </Border>

            <!--  Кнопка смены темы  -->
            <Border Padding="20" Stroke="{StaticResource DividerColor}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*,*">
                    <Label
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontSize="16"
                        HorizontalTextAlignment="Start"
                        Text="Тема"
                        TextColor="{StaticResource InkColor}" />

                    <Label
                        Grid.Column="1"
                        FontSize="16"
                        HorizontalTextAlignment="End"
                        Text="Светлая"
                        TextColor="{StaticResource MutedTextColor}" />
                </Grid>
            </Border>

            <!--  Кнопка удаления данных  -->
            <Border Padding="20" Stroke="{StaticResource DividerColor}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*,*">
                    <Label
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontSize="16"
                        HorizontalTextAlignment="Start"
                        Text="Удалить данные"
                        TextColor="{StaticResource ValidationErrorColor}" />
                </Grid>
            </Border>
        </VerticalStackLayout>
        
        <!--Всплывашка для смены языка-->
        <Border IsVisible="False"
                Grid.Row="2"
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource DividerColor}"
                StrokeShape="20"
                ZIndex="30">
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Хуйня для сворачивания панели  -->
                <Grid Grid.Row="0" BackgroundColor="Transparent">
                    <BoxView
                        BackgroundColor="{StaticResource InkColor}"
                        CornerRadius="2"
                        HeightRequest="4"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        WidthRequest="42" />
                </Grid>

                <!--  Список кнопок  -->
                <VerticalStackLayout
                    Grid.Row="1"
                    Padding="10,10"
                    Spacing="10">
                    
                    <!--  Русский  -->
                    <Border Padding="20" Stroke="{StaticResource EnergyDrinkIcoFill}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image
                                Grid.Column="0"
                                HeightRequest="24"
                                Source="russian_ico.png"
                                WidthRequest="24" />

                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="16"
                                HorizontalTextAlignment="Start"
                                Text="Русский"
                                TextColor="{StaticResource InkColor}" />
                        </Grid>
                    </Border>

                    <!--  Английский  -->
                    <Border Padding="20" Stroke="{StaticResource DividerColor}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image
                                Grid.Column="0"
                                HeightRequest="24"
                                Source="english_ico.png"
                                WidthRequest="24" />

                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="16"
                                HorizontalTextAlignment="Start"
                                Text="Английский"
                                TextColor="{StaticResource InkColor}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </Border>
        
        <!--Всплывашка для смены темы (Системная под вопросом)-->
        <Border IsVisible="False"
                Grid.Row="2"
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource DividerColor}"
                StrokeShape="20"
                ZIndex="30">
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Хуйня для сворачивания панели  -->
                <Grid Grid.Row="0" BackgroundColor="Transparent">
                    <BoxView
                        BackgroundColor="{StaticResource InkColor}"
                        CornerRadius="2"
                        HeightRequest="4"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        WidthRequest="42" />
                </Grid>

                <!--  Список кнопок  -->
                <VerticalStackLayout
                    Grid.Row="1"
                    Padding="10,10"
                    Spacing="10">

                    <!--  Системная  -->
                    <Border Padding="20" Stroke="{StaticResource DividerColor}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="16"
                                HorizontalTextAlignment="Start"
                                Text="Системная"
                                TextColor="{StaticResource InkColor}" />
                        </Grid>
                    </Border>

                    <!--  Светлая  -->
                    <Border Padding="20" Stroke="{StaticResource EnergyDrinkIcoFill}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Rectangle 
                                RadiusX="200"
                                RadiusY="200"
                                WidthRequest="24"
                                HeightRequest="24"
                                BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource DividerColor}"/>

                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="16"
                                HorizontalTextAlignment="Start"
                                Text="Светлая"
                                TextColor="{StaticResource InkColor}" />
                        </Grid>
                    </Border>

                    <!--  Темная  -->
                    <Border Padding="20" Stroke="{StaticResource DividerColor}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Rectangle 
                                RadiusX="200"
                                RadiusY="200"
                                WidthRequest="24"
                                HeightRequest="24"
                                BackgroundColor="{StaticResource EnergyDrinkIcoFill}"
                                Stroke="{StaticResource DividerColor}"/>

                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="16"
                                HorizontalTextAlignment="Start"
                                Text="Темная"
                                TextColor="{StaticResource InkColor}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!--  Nav Bar  -->
        <!--  Нижняя навигация вынесена в отдельный переиспользуемый контрол.  -->
        <controls:BottomNavigationBar
            x:Name="BottomNavigationBar"
            Grid.Row="2"
            BindingContext="{Binding Navigation}"
            HorizontalOptions="Center"
            MinimumHeightRequest="78"
            SafeAreaEdges="Container"
            VerticalOptions="End"
            ZIndex="20">

            <controls:BottomNavigationBar.Shadow>
                <Shadow
                    Brush="#40000000"
                    Opacity="0.45"
                    Radius="14"
                    Offset="0,-6" />
            </controls:BottomNavigationBar.Shadow>

        </controls:BottomNavigationBar>
    </Grid>
</ContentPage>
