<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CoffeeNap.Views.PrivacyPolicyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:CoffeeNap.Resources.Localization"
    AutomationId="PrivacyPage"
    BackgroundColor="{StaticResource SurfaceColor}"
    SafeAreaEdges="{OnPlatform Default=All, Android=None}"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False">

    <Grid SafeAreaEdges="None" RowDefinitions="Auto, *" RowSpacing="20" Padding="12,0">
        
        <!-- Page header. -->
        <Border Grid.Row="0"
                Padding="10"
                BackgroundColor="{StaticResource SurfaceColor}"
                Stroke="{StaticResource DividerColor}"
                StrokeShape="RoundRectangle 300"
                StrokeThickness="1">

            <Grid SafeAreaEdges="None" ColumnDefinitions="54,*,54" ColumnSpacing="12">
                <Button
                    Grid.Column="0"
                    AutomationId="PrivacyBack"
                    Padding="15"
                    BackgroundColor="{StaticResource SurfaceColor}"
                    Clicked="OnBackClicked"
                    CornerRadius="15"
                    HeightRequest="54"
                    ImageSource="back_ico.png"
                    SemanticProperties.Description="{localization:Translate Back}"
                    WidthRequest="54" />

                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontFamily="Inter"
                    FontSize="18"
                    HorizontalTextAlignment="Center"
                    Text="{localization:Translate PrivacyPolicy}"
                    TextColor="{StaticResource InkColor}"
                    VerticalTextAlignment="Center" />
            </Grid>
        </Border>

        <!-- Privacy Policy -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout>
            <Label
                Text="{localization:Translate PrivacyHeading}"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="{StaticResource InkColor}"
                LineBreakMode="WordWrap"
                Margin="0,0,0,10" />

            <Label
                Text="{localization:Translate PrivacyDate}"
                FontSize="16"
                TextColor="{StaticResource InkColor}"
                LineBreakMode="WordWrap"
                Margin="0,0,0,32" />

            <Label
                Text="{localization:Translate PrivacyIntro}"
                FontSize="16"
                TextColor="{StaticResource InkColor}"
                LineHeight="1.4"
                LineBreakMode="WordWrap"
                Margin="0,0,0,30" />

            <!-- 1 -->
            <Label
                Text="{localization:Translate PrivacyCollectionHeading}"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="{StaticResource InkColor}"
                Margin="0,0,0,12" />

            <Label
                Text="{localization:Translate PrivacyNoUpload}"
                FontSize="16"
                TextColor="{StaticResource InkColor}"
                LineHeight="1.4"
                LineBreakMode="WordWrap"
                Margin="0,0,0,12" />

            <Label
                Text="{localization:Translate PrivacyStoredIntro}"
                FontSize="16"
                TextColor="{StaticResource InkColor}"
                LineHeight="1.4"
                LineBreakMode="WordWrap"
                Margin="0,0,0,10" />

            <Label
                Text="{localization:Translate PrivacyStoredList}"
                FontSize="16"
                TextColor="{StaticResource InkColor}"
                LineHeight="1.4"
                LineBreakMode="WordWrap"
                Margin="0,0,0,12" />

            <Label
                Text="{localization:Translate PrivacyLocal}"
                FontSize="16"
                TextColor="{StaticResource InkColor}"
                LineHeight="1.4"
                LineBreakMode="WordWrap"
                Margin="0,0,0,30" />

            <!-- 2 -->
            <Label
                Text="{localization:Translate PrivacyTransferHeading}"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="{StaticResource InkColor}"
                Margin="0,0,0,12" />

            <Label
                Text="{localization:Translate PrivacyNoServers}"
                FontSize="16"
                TextColor="{StaticResource InkColor}"
                LineHeight="1.4"
                LineBreakMode="WordWrap"
                Margin="0,0,0,12" />

            <Label
                Text="{localization:Translate PrivacyNoSharing}"
                FontSize="16"
                TextColor="{StaticResource InkColor}"
                LineHeight="1.4"
                LineBreakMode="WordWrap"
                Margin="0,0,0,12" />

            <Label
                Text="{localization:Translate PrivacyNoAccess}"
                FontSize="16"
                TextColor="{StaticResource InkColor}"
                LineHeight="1.4"
                LineBreakMode="WordWrap"
                Margin="0,0,0,30" />

            <!-- 3 -->
            <Label
                Text="{localization:Translate PrivacyThirdPartyHeading}"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="{StaticResource InkColor}"
                Margin="0,0,0,12" />

            <Label
                Text="{localization:Translate PrivacyNoTracking}"
                FontSize="16"
                TextColor="{StaticResource InkColor}"
                LineHeight="1.4"
                LineBreakMode="WordWrap"
                Margin="0,0,0,12" />

            <Label
                Text="{localization:Translate PrivacyFutureServices}"
                FontSize="16"
                TextColor="{StaticResource InkColor}"
                LineHeight="1.4"
                LineBreakMode="WordWrap"
                Margin="0,0,0,30" />

            <!-- 4 -->
            <Label
                Text="{localization:Translate PrivacyStorageHeading}"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="{StaticResource InkColor}"
                Margin="0,0,0,12" />

            <Label
                Text="{localization:Translate PrivacyStorageLocal}"
                FontSize="16"
                TextColor="{StaticResource InkColor}"
                LineHeight="1.4"
                LineBreakMode="WordWrap"
                Margin="0,0,0,12" />

            <Label
                Text="{localization:Translate PrivacyBackup}"
                FontSize="16"
                TextColor="{StaticResource InkColor}"
                LineHeight="1.4"
                LineBreakMode="WordWrap"
                Margin="0,0,0,12" />

            <Label
                Text="{localization:Translate PrivacyOldBackups}"
                FontSize="16"
                TextColor="{StaticResource InkColor}"
                LineHeight="1.4"
                LineBreakMode="WordWrap"
                Margin="0,0,0,30" />

            <!-- 5 -->
            <Label
                Text="{localization:Translate PrivacySecurityHeading}"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="{StaticResource InkColor}"
                Margin="0,0,0,12" />

            <Label
                Text="{localization:Translate PrivacyNoCentralStorage}"
                FontSize="16"
                TextColor="{StaticResource InkColor}"
                LineHeight="1.4"
                LineBreakMode="WordWrap"
                Margin="0,0,0,12" />

            <Label
                Text="{localization:Translate PrivacyDeviceSecurity}"
                FontSize="16"
                TextColor="{StaticResource InkColor}"
                LineHeight="1.4"
                LineBreakMode="WordWrap"
                Margin="0,0,0,30" />

            <!-- 6 -->
            <Label
                Text="{localization:Translate PrivacyChildrenHeading}"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="{StaticResource InkColor}"
                Margin="0,0,0,12" />

            <Label
                Text="{localization:Translate PrivacyChildren}"
                FontSize="16"
                TextColor="{StaticResource InkColor}"
                LineHeight="1.4"
                LineBreakMode="WordWrap"
                Margin="0,0,0,12" />

            <Label
                Text="{localization:Translate PrivacyNoOnlineCollection}"
                FontSize="16"
                TextColor="{StaticResource InkColor}"
                LineHeight="1.4"
                LineBreakMode="WordWrap"
                Margin="0,0,0,30" />

            <!-- 7 -->
            <Label
                Text="{localization:Translate PrivacyChangesHeading}"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="{StaticResource InkColor}"
                Margin="0,0,0,12" />

            <Label
                Text="{localization:Translate PrivacyChanges}"
                FontSize="16"
                TextColor="{StaticResource InkColor}"
                LineHeight="1.4"
                LineBreakMode="WordWrap"
                Margin="0,0,0,12" />

            <Label
                Text="{localization:Translate PrivacyNewVersion}"
                FontSize="16"
                TextColor="{StaticResource InkColor}"
                LineHeight="1.4"
                LineBreakMode="WordWrap"
                Margin="0,0,0,30" />

            <!-- 8 -->
            <Label
                Text="{localization:Translate PrivacyContactHeading}"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="{StaticResource InkColor}"
                Margin="0,0,0,12" />

            <Label
                Text="{localization:Translate PrivacyContact}"
                FontSize="16"
                TextColor="{StaticResource InkColor}"
                LineHeight="1.4"
                LineBreakMode="WordWrap"
                Margin="0,0,0,30" />

            <VerticalStackLayout
                Margin="4,10,4,30"
                Spacing="2">

                <Label
                    FontSize="16"
                    Text="Made with ☕"
                    TextColor="{StaticResource InkColor}" />

                <Label
                    FontSize="16"
                    Text="Artem Hazhevalov · C# &amp; App Logic"
                    TextColor="{StaticResource InkColor}" />

                <Label
                    FontSize="16"
                    Text="Vladyslav Sharyi · UI &amp; Interface"
                    TextColor="{StaticResource InkColor}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
