<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CoffeeNap.Views.PrivacyPolicyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:CoffeeNap.Resources.Localization"
    xmlns:models="clr-namespace:CoffeeNap.Models"
    xmlns:views="clr-namespace:CoffeeNap.Views"
    x:DataType="views:PrivacyPolicyPage"
    BackgroundColor="{StaticResource SurfaceColor}"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid Padding="12,0" RowDefinitions="Auto,*" RowSpacing="20">
        <Border
            Grid.Row="0"
            Padding="10"
            BackgroundColor="{StaticResource SurfaceColor}"
            Stroke="{StaticResource DividerColor}"
            StrokeShape="RoundRectangle 300"
            StrokeThickness="1">
            <Grid ColumnDefinitions="54,*,54" ColumnSpacing="12">
                <Button
                    Grid.Column="0"
                    Padding="15"
                    BackgroundColor="{StaticResource SurfaceColor}"
                    Clicked="OnBackClicked"
                    CornerRadius="15"
                    HeightRequest="54"
                    ImageSource="back_ico.png"
                    WidthRequest="54" />
                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontFamily="Inter"
                    FontSize="18"
                    HorizontalTextAlignment="Center"
                    Text="{localization:Translate PrivacyPolicy}"
                    TextColor="{StaticResource InkColor}"
                    VerticalTextAlignment="Center" />
            </Grid>
        </Border>

        <!-- CollectionView создаёт только видимые секции длинного документа. -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Sections}"
            ItemSizingStrategy="MeasureAllItems"
            SelectionMode="None">
            <CollectionView.Header>
                <VerticalStackLayout Margin="0,0,0,24" Spacing="10">
                    <Label
                        FontAttributes="Bold"
                        FontSize="24"
                        LineBreakMode="WordWrap"
                        Text="Политика конфиденциальности Coffee Nap"
                        TextColor="{StaticResource InkColor}" />
                    <Label
                        FontSize="16"
                        LineBreakMode="WordWrap"
                        Text="Дата вступления в силу: 4 сентября 2026 года"
                        TextColor="{StaticResource InkColor}" />
                    <Label
                        Margin="0,14,0,0"
                        FontSize="16"
                        LineBreakMode="WordWrap"
                        LineHeight="1.4"
                        Text="Coffee Nap («Приложение») уважает вашу конфиденциальность. Мы разработали приложение таким образом, чтобы ваши данные оставались на вашем устройстве и не передавались нам или третьим лицам."
                        TextColor="{StaticResource InkColor}" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PrivacyPolicySection">
                    <VerticalStackLayout Margin="0,0,0,26" Spacing="10">
                        <Label
                            FontAttributes="Bold"
                            FontSize="20"
                            IsVisible="{Binding HasTitle}"
                            LineBreakMode="WordWrap"
                            Text="{Binding Title}"
                            TextColor="{StaticResource InkColor}" />
                        <Label
                            FontSize="16"
                            LineBreakMode="WordWrap"
                            LineHeight="1.4"
                            Text="{Binding Body}"
                            TextColor="{StaticResource InkColor}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <VerticalStackLayout Margin="4,10,4,30" Spacing="2">
                    <Label FontSize="16" Text="Made with ☕" TextColor="{StaticResource InkColor}" />
                    <Label FontSize="16" Text="Artem Hazhevalov · C# &amp; App Logic" TextColor="{StaticResource InkColor}" />
                    <Label FontSize="16" Text="Vladyslav Sharyi · UI &amp; Interface" TextColor="{StaticResource InkColor}" />
                </VerticalStackLayout>
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>
