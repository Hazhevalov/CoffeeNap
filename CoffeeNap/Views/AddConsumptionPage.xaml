<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CoffeeNap.Views.AddConsumptionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CoffeeNap.Controls"
    xmlns:converters="clr-namespace:CoffeeNap.Converters"
    xmlns:models="clr-namespace:CoffeeNap.Models"
    xmlns:steps="clr-namespace:CoffeeNap.Controls.AddConsumption.Steps"
    xmlns:viewModels="clr-namespace:CoffeeNap.ViewModels"
    Title="Добавление употребления"
    x:DataType="viewModels:AddConsumptionPageViewModel"
    BackgroundColor="{StaticResource PageBackgroundColor}"
    SafeAreaEdges="All"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <converters:ProgressStageToColorConverter x:Key="ProgressStageToColorConverter" />
    </ContentPage.Resources>

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Top Bar  -->
        <controls:MainHeaderView
            Grid.Row="0"
            BindingContext="{Binding Header}"
            HorizontalOptions="Fill"
            SafeAreaEdges="Container"
            VerticalOptions="Start" />

        <!--  Контент под header'ом  -->
        <Grid
            Grid.Row="1"
            Padding="10"
            IsVisible="True"
            RowDefinitions="Auto,*,Auto"
            RowSpacing="20"
            VerticalOptions="Fill">

            <!--  Кнопка назад и прогресс  -->
            <Grid Grid.Row="0">

                <Button
                    Padding="15"
                    BackgroundColor="{StaticResource White}"
                    BorderColor="{StaticResource DividerColor}"
                    BorderWidth="1"
                    CornerRadius="15"
                    HeightRequest="54"
                    HorizontalOptions="Start"
                    ImageSource="back_ico.png"
                    Command="{Binding BackCommand}"
                    VerticalOptions="Center"
                    WidthRequest="54" />

                <!--  Прогресс-бар расположен в центре всего Grid  -->
                <Grid
                    ColumnDefinitions="15,12,15,12,15,12,15,12,15,12,15"
                    HeightRequest="20"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="150">

                    <!--  Серая линия  -->
                    <BoxView
                        Grid.ColumnSpan="11"
                        Margin="7,0"
                        BackgroundColor="#D6D6D6"
                        HeightRequest="3"
                        VerticalOptions="Center" />

                    <!--  Пройденная часть  -->
                    <BoxView
                        Grid.ColumnSpan="{Binding ProgressColumnSpan}"
                        Margin="7,0"
                        BackgroundColor="#151515"
                        HeightRequest="3"
                        VerticalOptions="Center" />

                    <Border
                        Grid.Column="0"
                        BackgroundColor="White"
                        HeightRequest="15"
                        Stroke="{Binding ProgressStage, Converter={StaticResource ProgressStageToColorConverter}, ConverterParameter=1}"
                        StrokeThickness="2"
                        WidthRequest="15"
                        ZIndex="1">
                        <Border.StrokeShape>
                            <Ellipse />
                        </Border.StrokeShape>
                    </Border>

                    <Border
                        Grid.Column="2"
                        BackgroundColor="White"
                        HeightRequest="15"
                        Stroke="{Binding ProgressStage, Converter={StaticResource ProgressStageToColorConverter}, ConverterParameter=2}"
                        StrokeThickness="2"
                        WidthRequest="15"
                        ZIndex="1">
                        <Border.StrokeShape>
                            <Ellipse />
                        </Border.StrokeShape>
                    </Border>

                    <Border
                        Grid.Column="4"
                        BackgroundColor="White"
                        HeightRequest="15"
                        Stroke="{Binding ProgressStage, Converter={StaticResource ProgressStageToColorConverter}, ConverterParameter=3}"
                        StrokeThickness="2"
                        WidthRequest="15"
                        ZIndex="1">
                        <Border.StrokeShape>
                            <Ellipse />
                        </Border.StrokeShape>
                    </Border>

                    <Border
                        Grid.Column="6"
                        BackgroundColor="White"
                        HeightRequest="15"
                        Stroke="{Binding ProgressStage, Converter={StaticResource ProgressStageToColorConverter}, ConverterParameter=4}"
                        StrokeThickness="2"
                        WidthRequest="15"
                        ZIndex="1">
                        <Border.StrokeShape>
                            <Ellipse />
                        </Border.StrokeShape>
                    </Border>

                    <Border
                        Grid.Column="8"
                        BackgroundColor="White"
                        HeightRequest="15"
                        Stroke="{Binding ProgressStage, Converter={StaticResource ProgressStageToColorConverter}, ConverterParameter=5}"
                        StrokeThickness="2"
                        WidthRequest="15"
                        ZIndex="1">
                        <Border.StrokeShape>
                            <Ellipse />
                        </Border.StrokeShape>
                    </Border>

                    <Border
                        Grid.Column="10"
                        BackgroundColor="White"
                        HeightRequest="15"
                        Stroke="{Binding ProgressStage, Converter={StaticResource ProgressStageToColorConverter}, ConverterParameter=6}"
                        StrokeThickness="2"
                        WidthRequest="15"
                        ZIndex="1">
                        <Border.StrokeShape>
                            <Ellipse />
                        </Border.StrokeShape>
                    </Border>
                </Grid>
            </Grid>

            <steps:DrinkTypeStep Grid.Row="1" />

            <steps:CoffeeLocationStep Grid.Row="1" />

            <steps:BrewingMethodStep Grid.Row="1" />

            <steps:CoffeeAmountStep Grid.Row="1" />

            <steps:CupCountStep Grid.Row="1" />

            <steps:CoffeeBeanTypeStep Grid.Row="1" />

            <steps:ConsumptionResultStep Grid.Row="1" />

            <steps:CoffeeDrinkTypeStep Grid.Row="1" />

            <steps:CoffeeVolumeStep Grid.Row="1" />

            <!-- Надпись ошибки -->
            <Label
                Grid.Row="2"
                FontSize="13"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding HasValidationError}"
                Text="{Binding ValidationMessage}"
                TextColor="{StaticResource CaffeineProgressLimit}" />
            
        </Grid>

        <!--  Nav Bar  -->
        <!--  Нижняя навигация вынесена в отдельный переиспользуемый контрол.  -->
        <controls:BottomNavigationBar
            x:Name="BottomNavigationBar"
            Grid.Row="2"
            BindingContext="{Binding Navigation}"
            HorizontalOptions="Center"
            MinimumHeightRequest="78"
            SafeAreaEdges="Container"
            VerticalOptions="End"
            ZIndex="20">

            <controls:BottomNavigationBar.Shadow>
                <Shadow
                    Brush="#40000000"
                    Opacity="0.45"
                    Radius="14"
                    Offset="0,-6" />
            </controls:BottomNavigationBar.Shadow>

        </controls:BottomNavigationBar>
    </Grid>
</ContentPage>
