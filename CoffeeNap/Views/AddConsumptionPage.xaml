<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="CoffeeNap.Views.AddConsumptionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CoffeeNap.Controls"
    xmlns:viewModels="clr-namespace:CoffeeNap.ViewModels"
    x:DataType="viewModels:AddConsumptionPageViewModel"
    Title="Добавление употребления"
    BackgroundColor="{StaticResource PageBackgroundColor}"
    SafeAreaEdges="None"
    Shell.NavBarIsVisible="False">

    <Grid
        BackgroundColor="{StaticResource PageBackgroundColor}"
        SafeAreaEdges="None"
        RowSpacing="0">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <controls:MainHeaderView
            Grid.Row="0"
            HorizontalOptions="Fill"
            VerticalOptions="Start"
            BindingContext="{Binding Header}"
            SafeAreaEdges="Container" />

        <!-- Прогресс бар -->
        <Grid Grid.Row="1"
                WidthRequest="150"
                HeightRequest="50"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                ColumnDefinitions="15,12,15,12,15,12,15,12,15,12,15">
                <!-- Background line -->
                <BoxView
                    Grid.ColumnSpan="11"
                    Margin="7,0"
                    HeightRequest="3"
                    BackgroundColor="#D6D6D6"
                    VerticalOptions="Center" />
                <!-- Completed line -->
                <BoxView
                    Grid.ColumnSpan="9"
                    Margin="7,0"
                    HeightRequest="3"
                    BackgroundColor="#151515"
                    VerticalOptions="Center" />
                <!-- Step 1 -->
                <Border
                    Grid.Column="0"
                    WidthRequest="15"
                    HeightRequest="15"
                    BackgroundColor="White"
                    Stroke="#151515"
                    StrokeThickness="2"
                    ZIndex="1">
                    <Border.StrokeShape>
                        <Ellipse />
                    </Border.StrokeShape>
                </Border>
                <!-- Step 2 -->
                <Border
                    Grid.Column="2"
                    WidthRequest="15"
                    HeightRequest="15"
                    BackgroundColor="White"
                    Stroke="#151515"
                    StrokeThickness="2"
                    ZIndex="1">
                    <Border.StrokeShape>
                        <Ellipse />
                    </Border.StrokeShape>
                </Border>
                <!-- Step 3 -->
                <Border
                    Grid.Column="4"
                    WidthRequest="15"
                    HeightRequest="15"
                    BackgroundColor="White"
                    Stroke="#151515"
                    StrokeThickness="2"
                    ZIndex="1">
                    <Border.StrokeShape>
                        <Ellipse />
                    </Border.StrokeShape>
                </Border>
                <!-- Step 4 -->
                <Border
                    Grid.Column="6"
                    WidthRequest="15"
                    HeightRequest="15"
                    BackgroundColor="White"
                    Stroke="#151515"
                    StrokeThickness="2"
                    ZIndex="1">
                    <Border.StrokeShape>
                        <Ellipse />
                    </Border.StrokeShape>
                </Border>
                <!-- Step 5 -->
                <Border
                    Grid.Column="8"
                    WidthRequest="15"
                    HeightRequest="15"
                    BackgroundColor="White"
                    Stroke="#151515"
                    StrokeThickness="2"
                    ZIndex="1">
                    <Border.StrokeShape>
                        <Ellipse />
                    </Border.StrokeShape>
                </Border>
                <!-- Current / last step -->
                <Border
                    Grid.Column="10"
                    WidthRequest="15"
                    HeightRequest="15"
                    BackgroundColor="White"
                    Stroke="#D6D6D6"
                    StrokeThickness="2"
                    ZIndex="1">
                    <Border.StrokeShape>
                        <Ellipse />
                    </Border.StrokeShape>
                </Border>
                </Grid>

        <!-- Step 1 "Какой?" -->
        <!-- Сетка всего контента (Без Нав/Топ бара) -->
        <Grid IsVisible="False"
            Grid.Row="1"
            Padding="10"
            RowSpacing="20"
            VerticalOptions="Fill">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Бокс: Опрос и кнопка -->
            <Grid Grid.Row="0"
                VerticalOptions="Fill">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Сетка: Опрос и Кнопка -->
                <Grid IsVisible="True" Grid.Row="1" VerticalOptions="Fill">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Блок выбора напитка -->
                    <Grid Grid.Row="0"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="20"
                        HorizontalOptions="Fill"
                        VerticalOptions="Center">

                        <!-- Заголовок -->
                        <Label Grid.Row="0"
                            Text="Какой напиток&#10;вы пили?"
                            TextColor="{StaticResource InkColor}"
                            FontSize="32"
                            FontAttributes="Bold"
                            HorizontalOptions="Start"
                            VerticalOptions="Start" />

                        <!-- Карточки -->
                        <Grid Grid.Row="1"
                                ColumnDefinitions="*,*,*"
                                ColumnSpacing="5"
                                HorizontalOptions="Fill"
                                VerticalOptions="Start">

                            <!-- Кофе -->
                            <Border
                                Grid.Column="0"
                                Padding="16"
                                BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource DividerColor}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>

                                <VerticalStackLayout
                                    Spacing="10"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">

                                    <Border
                                        WidthRequest="56"
                                        HeightRequest="56"
                                        BackgroundColor="{StaticResource CaffeeIcoFill}"
                                        StrokeThickness="0">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="28" />
                                        </Border.StrokeShape>

                                        <Image
                                            Source="coffee_ico.png"
                                            WidthRequest="32"
                                            HeightRequest="32"
                                            Aspect="AspectFit" />
                                    </Border>

                                    <Label
                                        Text="Кофе"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource InkColor}"
                                        HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Энергетик -->
                            <Border
                                Grid.Column="1"
                                Padding="16"
                                BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource DividerColor}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>

                                <VerticalStackLayout
                                    Spacing="10"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">

                                    <Border
                                        WidthRequest="56"
                                        HeightRequest="56"
                                        BackgroundColor="{StaticResource EnergyDrinkIcoFill}"
                                        StrokeThickness="0">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="28" />
                                        </Border.StrokeShape>

                                        <Image
                                            Source="energy_drink_ico.png"
                                            WidthRequest="32"
                                            HeightRequest="32"
                                            Aspect="AspectFit" />
                                    </Border>

                                    <Label
                                        Text="Энергетик"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource InkColor}"
                                        HorizontalTextAlignment="Center"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Чай -->
                            <Border
                                Grid.Column="2"
                                Padding="16"
                                BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource DividerColor}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>

                                <VerticalStackLayout
                                    Spacing="10"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">

                                    <Border
                                        WidthRequest="56"
                                        HeightRequest="56"
                                        BackgroundColor="{StaticResource TeaIcoFill}"
                                        StrokeThickness="0">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="28" />
                                        </Border.StrokeShape>

                                        <Image
                                            Source="tea_ico.png"
                                            WidthRequest="32"
                                            HeightRequest="32"
                                            Aspect="AspectFit" />
                                    </Border>

                                    <Label
                                        Text="Чай"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource InkColor}"
                                        HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Кнопка старого рецепта -->
                    <Border Grid.Row="1"
                            StrokeThickness="1"
                            Stroke="{StaticResource DividerColor}"
                            VerticalOptions="End">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <Button
                            Text="Использовать старый рецепт"
                            TextColor="{StaticResource InkColor}"
                            BackgroundColor="{StaticResource White}"
                            Padding="25"
                            FontSize="16"
                            FontAttributes="Bold"
                            HorizontalOptions="Fill"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Step 2 "Где?"-->
        <Grid IsVisible="False"
            Grid.Row="1"
            Padding="10"
            RowSpacing="20"
            VerticalOptions="Fill">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" VerticalOptions="Center" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0"
                    Text="Где вы пили кофе?"
                    TextColor="{StaticResource InkColor}"
                    FontAttributes="Bold"
                    FontSize="32"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"/>

                <Grid Grid.Row="1" RowSpacing="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Home -->
                    <Border
                        Grid.Column="0"
                        Padding="16"
                        BackgroundColor="{StaticResource White}"
                        Stroke="{StaticResource DividerColor}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <VerticalStackLayout
                                Spacing="10"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                            
                            <Border
                                WidthRequest="56"
                                HeightRequest="56"
                                BackgroundColor="{StaticResource CaffeeIcoFill}"
                                StrokeThickness="0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="28" />
                                </Border.StrokeShape>
                                
                                <Image
                                    Source="home_active_ico.png"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    Aspect="AspectFit" />

                            </Border>

                            <Label
                                Text="Дома"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{StaticResource InkColor}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    
                    <!-- Cafe -->
                    <Border
                        Grid.Column="1"
                        Padding="16"
                        BackgroundColor="{StaticResource White}"
                        Stroke="{StaticResource DividerColor}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <VerticalStackLayout
                                Spacing="10"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">

                            <Border
                                WidthRequest="56"
                                HeightRequest="56"
                                BackgroundColor="{StaticResource TeaIcoFill}"
                                StrokeThickness="0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="28" />
                                </Border.StrokeShape>

                                <Image
                                    Source="cafe_ico.png"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    Aspect="AspectFit" />
                            </Border>

                            <Label
                                Text="В кафе"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{StaticResource InkColor}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Home Option 1 "Как заваривали?" -->
        <Grid IsVisible="False"
                Grid.Row="1"
                Padding="10,10,10,0"
                RowSpacing="20"
                VerticalOptions="Fill">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" VerticalOptions="End" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="450"/>
                </Grid.RowDefinitions>

                <!-- Заголовки -->
                <Grid Grid.Row="0" RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" 
                            Text="Домашний кофе" 
                            TextColor="{StaticResource MutedTextColor}"
                            FontSize="16"/>

                    <Label Grid.Row="1"
                            Text="Как вы заваривали?"
                            TextColor="{StaticResource InkColor}"
                            FontSize="32"
                            FontAttributes="Bold"/>

                    <Label Grid.Row="2"
                            Text="Это повысит нашу точность до 75%!"
                            TextColor="{StaticResource InkColor}"
                            FontSize="16"/>
                </Grid>

                <!-- Скроллящийся список методов приготовления -->
                <ScrollView Grid.Row="1">
                    <Grid RowSpacing="5" ColumnSpacing="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                    <!-- Эспрессо машина -->
                    <Border Grid.Column="0" Grid.Row="0"
                        Padding="16"
                        BackgroundColor="{StaticResource White}"
                        Stroke="{StaticResource DividerColor}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <VerticalStackLayout
                                Spacing="10"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                            
                            <Border
                                WidthRequest="56"
                                HeightRequest="56"
                                BackgroundColor="{StaticResource CaffeeIcoFill}"
                                StrokeThickness="0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="28" />
                                </Border.StrokeShape>
                                
                                <Image
                                    Source="espresso_machine_ico.png"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    Aspect="AspectFit" />

                            </Border>

                            <Label
                                Text="Эспрессо-машина"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{StaticResource InkColor}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Cold Brew -->
                    <Border Grid.Column="1" Grid.Row="0"
                        Padding="16"
                        BackgroundColor="{StaticResource White}"
                        Stroke="{StaticResource DividerColor}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <VerticalStackLayout
                                Spacing="10"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                            
                            <Border
                                WidthRequest="56"
                                HeightRequest="56"
                                BackgroundColor="{StaticResource CaffeeIcoFill}"
                                StrokeThickness="0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="28" />
                                </Border.StrokeShape>
                                
                                <Image
                                    Source="cold_brew_ico.png"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    Aspect="AspectFit" />

                            </Border>

                            <Label
                                Text="Cold brew"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{StaticResource InkColor}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Гейзер -->
                    <Border Grid.Column="0" Grid.Row="1"
                        Padding="16"
                        BackgroundColor="{StaticResource White}"
                        Stroke="{StaticResource DividerColor}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <VerticalStackLayout
                                Spacing="10"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                            
                            <Border
                                WidthRequest="56"
                                HeightRequest="56"
                                BackgroundColor="{StaticResource EnergyDrinkIcoFill}"
                                StrokeThickness="0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="28" />
                                </Border.StrokeShape>
                                
                                <Image
                                    Source="gayzer_ico.png"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    Aspect="AspectFit" />

                            </Border>

                            <Label
                                Text="Гейзер"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{StaticResource InkColor}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    
                    <!-- Френч пресс -->
                    <Border Grid.Column="1" Grid.Row="1"
                        Padding="16"
                        BackgroundColor="{StaticResource White}"
                        Stroke="{StaticResource DividerColor}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <VerticalStackLayout
                                Spacing="10"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                            
                            <Border
                                WidthRequest="56"
                                HeightRequest="56"
                                BackgroundColor="{StaticResource EnergyDrinkIcoFill}"
                                StrokeThickness="0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="28" />
                                </Border.StrokeShape>
                                
                                <Image
                                    Source="french_ico.png"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    Aspect="AspectFit" />

                            </Border>

                            <Label
                                Text="Френч-пресс"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{StaticResource InkColor}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    
                    <!-- Турка -->
                    <Border Grid.Column="0" Grid.Row="2"
                        Padding="16"
                        BackgroundColor="{StaticResource White}"
                        Stroke="{StaticResource DividerColor}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <VerticalStackLayout
                                Spacing="10"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                            
                            <Border
                                WidthRequest="56"
                                HeightRequest="56"
                                BackgroundColor="{StaticResource EnergyDrinkIcoFill}"
                                StrokeThickness="0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="28" />
                                </Border.StrokeShape>
                                
                                <Image
                                    Source="turka_ico.png"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    Aspect="AspectFit" />

                            </Border>

                            <Label
                                Text="Турка"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{StaticResource InkColor}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    
                    <!-- Воронка -->
                    <Border Grid.Column="1" Grid.Row="2"
                        Padding="16"
                        BackgroundColor="{StaticResource White}"
                        Stroke="{StaticResource DividerColor}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <VerticalStackLayout
                                Spacing="10"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                            
                            <Border
                                WidthRequest="56"
                                HeightRequest="56"
                                BackgroundColor="{StaticResource TeaIcoFill}"
                                StrokeThickness="0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="28" />
                                </Border.StrokeShape>
                                
                                <Image
                                    Source="funnel_ico.png"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    Aspect="AspectFit" />

                            </Border>

                            <Label
                                Text="Воронка"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{StaticResource InkColor}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    
                    <!-- Капсульная машина -->
                    <Border Grid.Column="0" Grid.Row="3"
                        Padding="16"
                        BackgroundColor="{StaticResource White}"
                        Stroke="{StaticResource DividerColor}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <VerticalStackLayout
                                Spacing="10"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                            
                            <Border
                                WidthRequest="56"
                                HeightRequest="56"
                                BackgroundColor="{StaticResource TeaIcoFill}"
                                StrokeThickness="0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="28" />
                                </Border.StrokeShape>
                                
                                <Image
                                    Source="capsul_ico.png"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    Aspect="AspectFit" />

                            </Border>

                            <Label
                                Text="Капсульная машина"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{StaticResource InkColor}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    </Grid>
                </ScrollView>
            </Grid>
        </Grid>

        <!-- Home Option 2 "Сколько кофе" -->
        <Grid IsVisible="False"
                Grid.Row="1"
                Padding="10,10,10,0"
                RowSpacing="20"
                VerticalOptions="Fill">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" VerticalOptions="Center" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовки -->
                <Grid Grid.Row="0" RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" 
                            Text="Домашний кофе" 
                            TextColor="{StaticResource MutedTextColor}"
                            FontSize="16"/>

                    <Label Grid.Row="1"
                            Text="Сколько кофе использовали?"
                            TextColor="{StaticResource InkColor}"
                            FontSize="32"
                            FontAttributes="Bold"/>

                    <Label Grid.Row="2"
                            Text="Можно примерно, это не проблема"
                            TextColor="{StaticResource InkColor}"
                            FontSize="16"/>
                </Grid>

                <!-- Варианты выбора -->
                <Grid Grid.Row="1" RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Stroke="{StaticResource DividerColor}"
                            StrokeThickness="1"
                            Padding="16,12"
                            BackgroundColor="{StaticResource White}">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Entry Placeholder="Знаю граммы"
                                BackgroundColor="{StaticResource White}"
                                FontSize="16" 
                                Keyboard="Numeric"
                                MaxLength="3"
                                ClearButtonVisibility="WhileEditing"
                                ReturnType="Next"/>
                    </Border>
                    
                    <Border Grid.Row="1" Stroke="{StaticResource DividerColor}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        
                        <Button Text="Одна ложка"
                            BackgroundColor="{StaticResource White}"
                            HorizontalOptions="Fill"
                            TextColor="{StaticResource InkColor}"
                            Padding="0,25"
                            FontSize="16"/>
                    </Border>
                
                    <Border Grid.Row="2" Stroke="{StaticResource DividerColor}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        
                        <Button Text="Две ложки"
                            BackgroundColor="{StaticResource White}"
                            HorizontalOptions="Fill"
                            TextColor="{StaticResource InkColor}"
                            Padding="0,25"
                            FontSize="16"/>
                    </Border>

                    <Border Grid.Row="3" Stroke="{StaticResource DividerColor}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        
                        <Button Text="Больше?"
                            BackgroundColor="{StaticResource White}"
                            HorizontalOptions="Fill"
                            TextColor="{StaticResource InkColor}"
                            Padding="0,25"
                            FontSize="16"/>
                    </Border>
                </Grid>

            </Grid>
        </Grid>

        <!-- Home Option 3 "Сколько чашек" -->
        <Grid IsVisible="False"
                Grid.Row="1"
                Padding="10,10,10,0"
                RowSpacing="20"
                VerticalOptions="Fill">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" VerticalOptions="Center" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовки -->
                <Grid Grid.Row="0" RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" 
                            Text="Домашний кофе" 
                            TextColor="{StaticResource MutedTextColor}"
                            FontSize="16"/>

                    <Label Grid.Row="1"
                            Text="Сколько чашек получилось?"
                            TextColor="{StaticResource InkColor}"
                            FontSize="32"
                            FontAttributes="Bold"/>

                    <Label Grid.Row="2"
                            Text="Он был вкусным?"
                            TextColor="{StaticResource InkColor}"
                            FontSize="16"/>
                </Grid>

                <!-- Варианты выбора -->
                <Grid Grid.Row="1" RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                
                    <Border Grid.Row="0" Stroke="{StaticResource DividerColor}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        
                        <Button Text="Одна чашка"
                            BackgroundColor="{StaticResource White}"
                            HorizontalOptions="Fill"
                            TextColor="{StaticResource InkColor}"
                            Padding="0,25"
                            FontSize="16"/>
                    </Border>

                    <Border Grid.Row="1" Stroke="{StaticResource DividerColor}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        
                        <Button Text="Две чашки"
                            BackgroundColor="{StaticResource White}"
                            HorizontalOptions="Fill"
                            TextColor="{StaticResource InkColor}"
                            Padding="0,25"
                            FontSize="16"/>
                    </Border>

                    <Border Grid.Row="2" Stroke="{StaticResource DividerColor}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        
                        <Button Text="Больше?"
                            BackgroundColor="{StaticResource White}"
                            HorizontalOptions="Fill"
                            TextColor="{StaticResource InkColor}"
                            Padding="0,25"
                            FontSize="16"/>
                    </Border>
                </Grid>
            

            </Grid>
        </Grid>

        <!-- Home Option 4 "Какой кофе?" -->
        <Grid IsVisible="False"
                Grid.Row="1"
                Padding="10,10,10,0"
                RowSpacing="20"
                VerticalOptions="Fill">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" VerticalOptions="Center" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовки -->
                <Grid Grid.Row="0" RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" 
                            Text="Домашний кофе" 
                            TextColor="{StaticResource MutedTextColor}"
                            FontSize="16"/>

                    <Label Grid.Row="1"
                            Text="Какой кофе?"
                            TextColor="{StaticResource InkColor}"
                            FontSize="32"
                            FontAttributes="Bold"/>

                    <Label Grid.Row="2"
                            Text="Вкусный"
                            TextColor="{StaticResource InkColor}"
                            FontSize="16"/>
                </Grid>

                <!-- Варианты выбора -->
                <Grid Grid.Row="1" RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                
                    <Border Grid.Row="0" Stroke="{StaticResource DividerColor}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        
                        <Button Text="Арабика"
                            BackgroundColor="{StaticResource White}"
                            HorizontalOptions="Fill"
                            TextColor="{StaticResource InkColor}"
                            Padding="0,25"
                            FontSize="16"/>
                    </Border>

                    <Border Grid.Row="1" Stroke="{StaticResource DividerColor}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        
                        <Button Text="Робутса"
                            BackgroundColor="{StaticResource White}"
                            HorizontalOptions="Fill"
                            TextColor="{StaticResource InkColor}"
                            Padding="0,25"
                            FontSize="16"/>
                    </Border>
                </Grid>
            

            </Grid>
        </Grid>

        <!-- Результат! --> 
        <Grid IsVisible="False"
                Grid.Row="1"
                Padding="10,10,10,0"
                RowSpacing="20"
                VerticalOptions="Fill">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" VerticalOptions="Center" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовки -->
                <Grid Grid.Row="0" RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" 
                            Text="Домашний кофе" 
                            TextColor="{StaticResource MutedTextColor}"
                            FontSize="16"/>

                    <Label Grid.Row="1"
                            Text="Результат!"
                            TextColor="{StaticResource InkColor}"
                            FontSize="32"
                            FontAttributes="Bold"/>

                    <Label Grid.Row="2"
                            Text="Он вас удивил?"
                            TextColor="{StaticResource InkColor}"
                            FontSize="16"/>
                </Grid>

                <!-- Суммирующий блок -->
                <Border Grid.Row="1"
                        Background="{StaticResource White}"
                        Stroke="{StaticResource DividerColor}"
                        Padding="25">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>

                    <Grid RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок -->
                        <Label Grid.Row="0"
                            Text="Кофе"
                            TextColor="{StaticResource InkColor}"
                            FontAttributes="Bold"
                            FontSize="24"/>

                        <!-- Список -->
                        <VerticalStackLayout Grid.Row="1" Spacing="10"> 
                            <!-- Параметр -->
                            <Label Text="Эспрессо-машина" FontSize="16"/>
                            
                            <!-- Параметр + значение -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="Одна ложка" FontSize="16"/>
                                <Label Grid.Column="1" Text="8г" FontSize="16" TextColor="#999999"/>
                            </Grid>
                            
                            <!-- Параметр -->
                            <Label Text="Одна чашка" FontSize="16"/>

                            <!-- Параметр + значение -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="Арабика" FontSize="16"/>
                                <Label Grid.Column="1" Text="×1" FontSize="16" TextColor="#999999"/>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Итог -->
                        <Grid Grid.Column="0" Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="Итого:" FontSize="24"/>
                            <Label Grid.Column="1" Text="+120мг" FontSize="24"/>
                        </Grid>
                    </Grid>
                </Border>
                
                <!-- Изменить данные -->
                <Grid Grid.Row="2">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                        <Button
                            MaximumHeightRequest="56"
                            Padding="25"
                            BackgroundColor="{StaticResource White}"
                            TextColor="{StaticResource InkColor}"
                            FontSize="16"
                            BorderWidth="0"
                            CornerRadius="20"
                            Text="Изменить данные"
                            HorizontalOptions="Fill"/>

                        <Label Text="или"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            FontSize="16"
                            TextColor="{StaticResource MutedTextColor}"/>

                        <Button
                            MaximumHeightRequest="56"
                            Padding="25"
                            BackgroundColor="{StaticResource InkColor}"
                            TextColor="{StaticResource White}"
                            FontSize="16"
                            BorderWidth="0"
                            CornerRadius="20"
                            Text="Сохранить и выпить"
                            HorizontalOptions="Fill"/>

                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Grid>
        
        <!-- Cafe Option "Какой?" -->
        <Grid IsVisible="False"
                Grid.Row="1"
                Padding="10,10,10,0"
                RowSpacing="20"
                VerticalOptions="Fill">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" VerticalOptions="Center" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Заголовки -->
                <Grid Grid.Row="0" RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" 
                            Text="Кофе вне дома" 
                            TextColor="{StaticResource MutedTextColor}"
                            FontSize="16"/>

                    <Label Grid.Row="1"
                            Text="Какой вид напитка вы пили?"
                            TextColor="{StaticResource InkColor}"
                            FontSize="32"
                            FontAttributes="Bold"/>

                    <Label Grid.Row="2"
                            Text="Он вас порадовал?"
                            TextColor="{StaticResource InkColor}"
                            FontSize="16"/>
                </Grid>
            
                <!-- Блочный список видов напитка -->
                <FlexLayout Grid.Row="1"
                            Wrap="Wrap"
                            Direction="Row"
                            JustifyContent="Start"
                            AlignContent="Start"
                            AlignItems="Start">
                    
                    <Button Text="Еспрессо"
                            Margin="2"
                            CornerRadius="15"
                            BackgroundColor="{StaticResource White}"
                            TextColor="{StaticResource InkColor}"
                            FontSize="16"
                            BorderWidth="1"
                            BorderColor="{StaticResource DividerColor}"/>

                    <Button Text="Макиато"
                            Margin="2"
                            CornerRadius="15"
                            BackgroundColor="{StaticResource White}"
                            TextColor="{StaticResource InkColor}"
                            FontSize="16"
                            BorderWidth="1"
                            BorderColor="{StaticResource DividerColor}"/>

                    <Button Text="Ристретто"
                            Margin="2"
                            CornerRadius="15"
                            BackgroundColor="{StaticResource White}"
                            TextColor="{StaticResource InkColor}"
                            FontSize="16"
                            BorderWidth="1"
                            BorderColor="{StaticResource DividerColor}"/>

                    <Button Text="Американо"
                            Margin="2"
                            CornerRadius="15"
                            BackgroundColor="{StaticResource White}"
                            TextColor="{StaticResource InkColor}"
                            FontSize="16"
                            BorderWidth="1"
                            BorderColor="{StaticResource DividerColor}"/>

                    <Button Text="Капучино"
                            Margin="2"
                            CornerRadius="15"
                            BackgroundColor="{StaticResource White}"
                            TextColor="{StaticResource InkColor}"
                            FontSize="16"
                            BorderWidth="1"
                            BorderColor="{StaticResource DividerColor}"/>

                    <Button Text="Латте"
                            Margin="2"
                            CornerRadius="15"
                            BackgroundColor="{StaticResource White}"
                            TextColor="{StaticResource InkColor}"
                            FontSize="16"
                            BorderWidth="1"
                            BorderColor="{StaticResource DividerColor}"/>

                    <Button Text="Флэт-Уайт"
                            Margin="2"
                            CornerRadius="15"
                            BackgroundColor="{StaticResource White}"
                            TextColor="{StaticResource InkColor}"
                            FontSize="16"
                            BorderWidth="1"
                            BorderColor="{StaticResource DividerColor}"/>

                    <Button Text="Мокко"
                            Margin="2"
                            CornerRadius="15"
                            BackgroundColor="{StaticResource White}"
                            TextColor="{StaticResource InkColor}"
                            FontSize="16"
                            BorderWidth="1"
                            BorderColor="{StaticResource DividerColor}"/>

                    <Button Text="Доппио"
                            Margin="2"
                            CornerRadius="15"
                            BackgroundColor="{StaticResource White}"
                            TextColor="{StaticResource InkColor}"
                            FontSize="16"
                            BorderWidth="1"
                            BorderColor="{StaticResource DividerColor}"/>

                    <Button Text="Аффогато"
                            Margin="2"
                            CornerRadius="15"
                            BackgroundColor="{StaticResource White}"
                            TextColor="{StaticResource InkColor}"
                            FontSize="16"
                            BorderWidth="1"
                            BorderColor="{StaticResource DividerColor}"/>

                </FlexLayout>
            </Grid>
        </Grid>
        
        <!-- Объем -->
        <Grid IsVisible="True"
                Grid.Row="1"
                Padding="10,10,10,0"
                RowSpacing="20"
                VerticalOptions="Fill">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" VerticalOptions="Center" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Заголовки -->
                <Grid Grid.Row="0" RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" 
                            Text="Кофе вне дома" 
                            TextColor="{StaticResource MutedTextColor}"
                            FontSize="16"/>

                    <Label Grid.Row="1"
                            Text="Объем"
                            TextColor="{StaticResource InkColor}"
                            FontSize="32"
                            FontAttributes="Bold"/>

                    <Label Grid.Row="2"
                            Text="Размер имеет значение!"
                            TextColor="{StaticResource InkColor}"
                            FontSize="16"/>
                </Grid>

                <!-- Варианты выбора -->
                <Grid Grid.Row="1" RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Stroke="{StaticResource DividerColor}"
                            StrokeThickness="1"
                            Padding="16,12"
                            BackgroundColor="{StaticResource White}">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Entry Placeholder="Знаю миллилитры"
                                BackgroundColor="{StaticResource White}"
                                FontSize="16" 
                                Keyboard="Numeric"
                                MaxLength="3"
                                ClearButtonVisibility="WhileEditing"
                                ReturnType="Next"/>
                    </Border>
                    
                    <Border Grid.Row="1" Stroke="{StaticResource DividerColor}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        
                        <Button Text="Маленький"
                            BackgroundColor="{StaticResource White}"
                            HorizontalOptions="Fill"
                            TextColor="{StaticResource InkColor}"
                            Padding="0,25"
                            FontSize="16"/>
                    </Border>
                
                    <Border Grid.Row="2" Stroke="{StaticResource DividerColor}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        
                        <Button Text="Средний"
                            BackgroundColor="{StaticResource White}"
                            HorizontalOptions="Fill"
                            TextColor="{StaticResource InkColor}"
                            Padding="0,25"
                            FontSize="16"/>
                    </Border>

                    <Border Grid.Row="3" Stroke="{StaticResource DividerColor}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        
                        <Button Text="Большой"
                            BackgroundColor="{StaticResource White}"
                            HorizontalOptions="Fill"
                            TextColor="{StaticResource InkColor}"
                            Padding="0,25"
                            FontSize="16"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Nav Bar -->
        <controls:BottomNavigationBar Grid.Row="2"
            HorizontalOptions="Fill"
            VerticalOptions="End"
            BindingContext="{Binding Navigation}"
            SafeAreaEdges="Container">

            <controls:BottomNavigationBar.Shadow>
                <Shadow
                    Brush="#40000000"
                    Offset="0,-6"
                    Radius="14"
                    Opacity="0.45" />
            </controls:BottomNavigationBar.Shadow>

        </controls:BottomNavigationBar>
    </Grid>

</ContentPage>