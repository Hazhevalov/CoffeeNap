<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CoffeeNap.Views.AddConsumptionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:CoffeeNap.Resources.Localization"
    xmlns:controls="clr-namespace:CoffeeNap.Controls"
    xmlns:models="clr-namespace:CoffeeNap.Models"
    xmlns:steps="clr-namespace:CoffeeNap.Controls.AddConsumption.Steps"
    xmlns:viewModels="clr-namespace:CoffeeNap.ViewModels"
    x:DataType="viewModels:AddConsumptionPageViewModel"
    AutomationId="AddTabContent"
    BackgroundColor="{StaticResource PageBackgroundColor}">

    <Grid SafeAreaEdges="None" RowSpacing="0" Padding="12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="86" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Top Bar  -->
        <controls:MainHeaderView
            Grid.Row="0"
            HeightRequest="86"
            BindingContext="{Binding Header}"
            HorizontalOptions="Fill"
            SafeAreaEdges="None"
            VerticalOptions="Start" />

        <!-- Content below the header. -->
        <ScrollView x:Name="QuizScroll" Grid.Row="1" VerticalScrollBarVisibility="Default">
        <Grid SafeAreaEdges="None"
            MinimumHeightRequest="{Binding Height, Source={x:Reference QuizScroll}, x:DataType=ScrollView}"
            Padding="0,10"
            IsVisible="True"
            RowDefinitions="Auto,*,Auto"
            RowSpacing="20"
            VerticalOptions="Fill">

            <!-- Back button and progress indicator. -->
            <Grid SafeAreaEdges="None" Grid.Row="0">

                <Button
                    Padding="15"
                    BackgroundColor="{StaticResource White}"
                    BorderColor="{StaticResource DividerColor}"
                    BorderWidth="1"
                    CornerRadius="15"
                    HeightRequest="54"
                    HorizontalOptions="Start"
                    ImageSource="back_ico.png"
                    Command="{Binding BackCommand}"
                    VerticalOptions="Center"
                    WidthRequest="54" />

                <!-- The dot count matches the selected quiz branch length. -->
                <controls:QuizProgressView
                    CurrentPosition="{Binding ProgressPosition}"
                    HorizontalOptions="Center"
                    StepCount="{Binding ProgressStepCount}"
                    VerticalOptions="Center" />
            </Grid>

            <steps:DrinkTypeStep Grid.Row="1" />

            <steps:CoffeeLocationStep Grid.Row="1" />

            <steps:BrewingMethodStep Grid.Row="1" />

            <steps:CoffeeAmountStep Grid.Row="1" />

            <steps:CoffeeBeanTypeStep Grid.Row="1" />

            <steps:ConsumptionResultStep Grid.Row="1" />

            <steps:CoffeeDrinkTypeStep Grid.Row="1" />

            <steps:CoffeeVolumeStep Grid.Row="1" />

            <steps:TeaSort Grid.Row="1" />

            <steps:TeaAmount Grid.Row="1" />

            <steps:EnergyDrinkVolume Grid.Row="1" />

            <!-- Validation error label. -->
            <Label
                Grid.Row="2"
                FontSize="13"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding HasValidationError}"
                Text="{Binding ValidationMessage}"
                TextColor="{StaticResource CaffeineProgressLimit}" />
            
        </Grid>
        </ScrollView>

    </Grid>
</ContentView>
