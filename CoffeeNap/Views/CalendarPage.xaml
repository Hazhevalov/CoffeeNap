<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CoffeeNap.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CoffeeNap.Controls"
    xmlns:converters="clr-namespace:CoffeeNap.Converters"
    xmlns:localization="clr-namespace:CoffeeNap.Resources.Localization"
    xmlns:models="clr-namespace:CoffeeNap.Models"
    xmlns:viewModels="clr-namespace:CoffeeNap.ViewModels"
    x:DataType="viewModels:CalendarPageViewModel"
    Title="{localization:Translate CalendarTitle}"
    BackgroundColor="{StaticResource PageBackgroundColor}"
    SafeAreaEdges="All"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <converters:CaffeineLevelToColorConverter x:Key="CaffeineLevelToColorConverter" />
        <converters:RatioToGridLengthConverter x:Key="RatioToGridLengthConverter" />
    </ContentPage.Resources>

    <Grid Padding="12,0" RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <controls:MainHeaderView
            Grid.Row="0"
            HeightRequest="86"
            BindingContext="{Binding Header}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="10">
                <Border
                    Padding="10"
                    BackgroundColor="{StaticResource SurfaceColor}"
                    Stroke="{StaticResource DividerColor}"
                    StrokeShape="RoundRectangle 30"
                    StrokeThickness="1">
                    <Grid ColumnDefinitions="54,*,54" ColumnSpacing="12">
                        <Button
                            Grid.Column="0"
                            Padding="15"
                            BackgroundColor="{StaticResource SurfaceColor}"
                            Command="{Binding ShowPreviousMonthCommand}"
                            CornerRadius="15"
                            HeightRequest="54"
                            ImageSource="back_ico.png"
                            WidthRequest="54" />

                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontFamily="Inter"
                            FontSize="18"
                            HorizontalTextAlignment="Center"
                            Text="{Binding MonthTitle}"
                            TextColor="{StaticResource InkColor}"
                            VerticalTextAlignment="Center" />

                        <Button
                            Grid.Column="2"
                            Padding="15"
                            BackgroundColor="{StaticResource SurfaceColor}"
                            Command="{Binding ShowNextMonthCommand}"
                            CornerRadius="15"
                            HeightRequest="54"
                            ImageSource="back_ico.png"
                            Rotation="180"
                            WidthRequest="54" />
                    </Grid>
                </Border>

                <Border
                    Padding="14,18"
                    BackgroundColor="{StaticResource SurfaceColor}"
                    Stroke="{StaticResource DividerColor}"
                    StrokeShape="RoundRectangle 30"
                    StrokeThickness="1">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                            <Label FontSize="12" HorizontalTextAlignment="Center" Text="{localization:Translate MondayShort}" TextColor="{StaticResource MutedTextColor}" />
                            <Label Grid.Column="1" FontSize="12" HorizontalTextAlignment="Center" Text="{localization:Translate TuesdayShort}" TextColor="{StaticResource MutedTextColor}" />
                            <Label Grid.Column="2" FontSize="12" HorizontalTextAlignment="Center" Text="{localization:Translate WednesdayShort}" TextColor="{StaticResource MutedTextColor}" />
                            <Label Grid.Column="3" FontSize="12" HorizontalTextAlignment="Center" Text="{localization:Translate ThursdayShort}" TextColor="{StaticResource MutedTextColor}" />
                            <Label Grid.Column="4" FontSize="12" HorizontalTextAlignment="Center" Text="{localization:Translate FridayShort}" TextColor="{StaticResource MutedTextColor}" />
                            <Label Grid.Column="5" FontSize="12" HorizontalTextAlignment="Center" Text="{localization:Translate SaturdayShort}" TextColor="{StaticResource MutedTextColor}" />
                            <Label Grid.Column="6" FontSize="12" HorizontalTextAlignment="Center" Text="{localization:Translate SundayShort}" TextColor="{StaticResource MutedTextColor}" />
                        </Grid>

                        <CollectionView
                            HeightRequest="{Binding CalendarHeight}"
                            HorizontalScrollBarVisibility="Never"
                            ItemsSource="{Binding Days}"
                            SelectionMode="None"
                            VerticalScrollBarVisibility="Never">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout
                                    HorizontalItemSpacing="3"
                                    Orientation="Vertical"
                                    Span="7"
                                    VerticalItemSpacing="6" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:CalendarDayItem">
                                    <Grid HeightRequest="40">
                                        <Border
                                            Margin="1"
                                            BackgroundColor="{Binding Level, Converter={StaticResource CaffeineLevelToColorConverter}}"
                                            IsVisible="{Binding IsCurrentMonth}"
                                            Stroke="{StaticResource DividerColor}"
                                            StrokeShape="RoundRectangle 20"
                                            StrokeThickness="1">
                                            <Border.Triggers>
                                                <DataTrigger Binding="{Binding IsToday}" TargetType="Border" Value="True">
                                                    <Setter Property="Stroke" Value="{StaticResource InkColor}" />
                                                    <Setter Property="StrokeThickness" Value="2" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label
                                                FontAttributes="Bold"
                                                FontFamily="Inter"
                                                FontSize="14"
                                                HorizontalTextAlignment="Center"
                                                Text="{Binding DayNumber}"
                                                TextColor="{StaticResource InkColor}"
                                                VerticalTextAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="8">
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="0" HorizontalOptions="Center" Spacing="6">
                                <BoxView BackgroundColor="{StaticResource CaffeineProgressLow}" CornerRadius="5" HeightRequest="10" VerticalOptions="Center" WidthRequest="10" />
                                <Label FontSize="11" Text="{Binding LowRangeLabel}" TextColor="{StaticResource MutedTextColor}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="1" HorizontalOptions="Center" Spacing="6">
                                <BoxView BackgroundColor="{StaticResource CaffeineProgressMedium}" CornerRadius="5" HeightRequest="10" VerticalOptions="Center" WidthRequest="10" />
                                <Label FontSize="11" Text="{Binding MediumRangeLabel}" TextColor="{StaticResource MutedTextColor}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" HorizontalOptions="Center" Spacing="6">
                                <BoxView BackgroundColor="{StaticResource CaffeineProgressHigh}" CornerRadius="5" HeightRequest="10" VerticalOptions="Center" WidthRequest="10" />
                                <Label FontSize="11" Text="{Binding HighRangeLabel}" TextColor="{StaticResource MutedTextColor}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" HorizontalOptions="Center" Spacing="6">
                                <BoxView BackgroundColor="{StaticResource CaffeineProgressLimit}" CornerRadius="5" HeightRequest="10" VerticalOptions="Center" WidthRequest="10" />
                                <Label FontSize="11" Text="{Binding ExceededRangeLabel}" TextColor="{StaticResource MutedTextColor}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border
                    Padding="15,20"
                    BackgroundColor="{StaticResource SurfaceColor}"
                    Stroke="{StaticResource DividerColor}"
                    StrokeShape="RoundRectangle 30"
                    StrokeThickness="1">
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout
                            Spacing="9"
                            BindableLayout.ItemsSource="{Binding WeeklyDays}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:WeeklyConsumptionItem">
                                    <Grid ColumnDefinitions="34,*" ColumnSpacing="10">
                                        <Label
                                            FontFamily="Inter"
                                            FontSize="12"
                                            HorizontalTextAlignment="Center"
                                            Text="{Binding DayLabel}"
                                            TextColor="{StaticResource MutedTextColor}"
                                            VerticalTextAlignment="Center">
                                            <Label.Triggers>
                                                <DataTrigger Binding="{Binding IsToday}" TargetType="Label" Value="True">
                                                    <Setter Property="FontAttributes" Value="Bold" />
                                                    <Setter Property="TextColor" Value="{StaticResource InkColor}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <Border
                                            Grid.Column="1"
                                            HeightRequest="20"
                                            BackgroundColor="{StaticResource SurfaceColor}"
                                            Stroke="{StaticResource DividerColor}"
                                            StrokeShape="RoundRectangle 10"
                                            StrokeThickness="1">
                                            <Grid ColumnSpacing="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding CoffeeRatio, Converter={StaticResource RatioToGridLengthConverter}}" />
                                                    <ColumnDefinition Width="{Binding TeaRatio, Converter={StaticResource RatioToGridLengthConverter}}" />
                                                    <ColumnDefinition Width="{Binding EnergyDrinkRatio, Converter={StaticResource RatioToGridLengthConverter}}" />
                                                    <ColumnDefinition Width="{Binding EmptyRatio, Converter={StaticResource RatioToGridLengthConverter}}" />
                                                </Grid.ColumnDefinitions>
                                                <BoxView Grid.Column="0" BackgroundColor="{StaticResource CaffeeIcoFill}" />
                                                <BoxView Grid.Column="1" BackgroundColor="{StaticResource TeaIcoFill}" />
                                                <BoxView Grid.Column="2" BackgroundColor="{StaticResource EnergyDrinkIcoFill}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="18">
                            <HorizontalStackLayout Spacing="6">
                                <BoxView BackgroundColor="{StaticResource CaffeeIcoFill}" CornerRadius="5" HeightRequest="10" VerticalOptions="Center" WidthRequest="10" />
                                <Label FontSize="12" Text="{localization:Translate Coffee}" TextColor="{StaticResource MutedTextColor}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6">
                                <BoxView BackgroundColor="{StaticResource TeaIcoFill}" CornerRadius="5" HeightRequest="10" VerticalOptions="Center" WidthRequest="10" />
                                <Label FontSize="12" Text="{localization:Translate Tea}" TextColor="{StaticResource MutedTextColor}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6">
                                <BoxView BackgroundColor="{StaticResource EnergyDrinkIcoFill}" CornerRadius="5" HeightRequest="10" VerticalOptions="Center" WidthRequest="10" />
                                <Label FontSize="12" Text="{localization:Translate EnergyDrinks}" TextColor="{StaticResource MutedTextColor}" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label
                    IsVisible="{Binding HasLoadError}"
                    HorizontalTextAlignment="Center"
                    Text="{Binding LoadError}"
                    TextColor="{StaticResource ValidationErrorColor}" />
            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNavigationBar
            Grid.Row="2"
            BindingContext="{Binding Navigation}"
            HorizontalOptions="Center"
            VerticalOptions="Start"
            ZIndex="20">
            <controls:BottomNavigationBar.Shadow>
                <Shadow Brush="#40000000" Offset="0,-6" Opacity="0.45" Radius="14" />
            </controls:BottomNavigationBar.Shadow>
        </controls:BottomNavigationBar>
    </Grid>
</ContentPage>
