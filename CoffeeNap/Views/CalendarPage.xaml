<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CoffeeNap.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CoffeeNap.Controls"
    xmlns:localization="clr-namespace:CoffeeNap.Resources.Localization"
    xmlns:viewModels="clr-namespace:CoffeeNap.ViewModels"
    x:DataType="viewModels:CalendarPageViewModel"
    Title="{localization:Translate CalendarTitle}"
    BackgroundColor="{StaticResource PageBackgroundColor}"
    SafeAreaEdges="{OnPlatform Default=All, Android=None}"
    Shell.NavBarIsVisible="False">

    <Grid SafeAreaEdges="None" Padding="12,0" RowDefinitions="86,*,88" RowSpacing="10">
        <controls:MainHeaderView
            Grid.Row="0"
            HeightRequest="86"
            BindingContext="{Binding Header}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="10">
                <!-- Выбор месяца -->
                <Border
                    Padding="10"
                    BackgroundColor="{StaticResource SurfaceColor}"
                    Stroke="{StaticResource DividerColor}"
                    StrokeShape="RoundRectangle 30"
                    StrokeThickness="1">

                    <Grid SafeAreaEdges="None" ColumnDefinitions="54,*,54" ColumnSpacing="12">
                        <Button
                            Grid.Column="0"
                            Padding="15"
                            BackgroundColor="{StaticResource SurfaceColor}"
                            Command="{Binding ShowPreviousMonthCommand}"
                            CornerRadius="15"
                            HeightRequest="54"
                            ImageSource="back_ico.png"
                            WidthRequest="54" />

                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontFamily="Inter"
                            FontSize="18"
                            HorizontalTextAlignment="Center"
                            Text="{Binding MonthTitle}"
                            TextColor="{StaticResource InkColor}"
                            VerticalTextAlignment="Center" />

                        <Button
                            Grid.Column="2"
                            Padding="15"
                            BackgroundColor="{StaticResource SurfaceColor}"
                            Command="{Binding ShowNextMonthCommand}"
                            CornerRadius="15"
                            HeightRequest="54"
                            ImageSource="back_ico.png"
                            Rotation="180"
                            WidthRequest="54" />
                    </Grid>
                </Border>

                <!-- Блок календаря -->
                <Border
                    Padding="14,18"
                    BackgroundColor="{StaticResource SurfaceColor}"
                    Stroke="{StaticResource DividerColor}"
                    StrokeShape="RoundRectangle 25"
                    StrokeThickness="1">
                    <VerticalStackLayout Spacing="14">
                        <Grid SafeAreaEdges="None" ColumnDefinitions="*,*,*,*,*,*,*">
                            <Label FontSize="12" HorizontalTextAlignment="Center" VerticalOptions="Center" Text="{localization:Translate MondayShort}" TextColor="{StaticResource MutedTextColor}" />
                            <Label Grid.Column="1" FontSize="12" HorizontalTextAlignment="Center" VerticalOptions="Center" Text="{localization:Translate TuesdayShort}" TextColor="{StaticResource MutedTextColor}" />
                            <Label Grid.Column="2" FontSize="12" HorizontalTextAlignment="Center" VerticalOptions="Center" Text="{localization:Translate WednesdayShort}" TextColor="{StaticResource MutedTextColor}" />
                            <Label Grid.Column="3" FontSize="12" HorizontalTextAlignment="Center" VerticalOptions="Center" Text="{localization:Translate ThursdayShort}" TextColor="{StaticResource MutedTextColor}" />
                            <Label Grid.Column="4" FontSize="12" HorizontalTextAlignment="Center" VerticalOptions="Center" Text="{localization:Translate FridayShort}" TextColor="{StaticResource MutedTextColor}" />
                            <Label Grid.Column="5" FontSize="12" HorizontalTextAlignment="Center" VerticalOptions="Center" Text="{localization:Translate SaturdayShort}" TextColor="{StaticResource MutedTextColor}" />
                            <Label Grid.Column="6" FontSize="12" HorizontalTextAlignment="Center" VerticalOptions="Center" Text="{localization:Translate SundayShort}" TextColor="{StaticResource MutedTextColor}" />
                        </Grid>

                        <controls:CalendarMonthView ItemsSource="{Binding Days}" />

                        <Grid SafeAreaEdges="None" ColumnDefinitions="*,*,*,*" ColumnSpacing="10" RowDefinitions="Auto">
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                                <BoxView BackgroundColor="{StaticResource CaffeineProgressLow}" CornerRadius="5" HeightRequest="10" VerticalOptions="Center" WidthRequest="10" />
                                <Label FontSize="11" Text="{Binding LowRangeLabel}" TextColor="{StaticResource MutedTextColor}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                                <BoxView BackgroundColor="{StaticResource CaffeineProgressMedium}" CornerRadius="5" HeightRequest="10" VerticalOptions="Center" WidthRequest="10" />
                                <Label FontSize="11" Text="{Binding MediumRangeLabel}" TextColor="{StaticResource MutedTextColor}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                                <BoxView BackgroundColor="{StaticResource CaffeineProgressHigh}" CornerRadius="5" HeightRequest="10" VerticalOptions="Center" WidthRequest="10" />
                                <Label FontSize="11" Text="{Binding HighRangeLabel}" TextColor="{StaticResource MutedTextColor}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                                <BoxView BackgroundColor="{StaticResource CaffeineProgressLimit}" CornerRadius="5" HeightRequest="10" VerticalOptions="Center" WidthRequest="10" />
                                <Label FontSize="11" Text="{Binding ExceededRangeLabel}" TextColor="{StaticResource MutedTextColor}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                
                <!-- Лучшее комбо -->
                <Border
                    Background="{StaticResource White}"
                    Stroke="{StaticResource DividerColor}"
                    StrokeThickness="1"
                    StrokeShape="20"
                    Padding="15,20">
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Spacing="10">
                            <Image WidthRequest="24" 
                                HeightRequest="24" 
                                Source="best_combo_ico.png"/>

                            <Label TextColor="{StaticResource InkColor}" 
                                Grid.Column="0" 
                                VerticalOptions="Center"
                                Text="Ваше лучшее комбо:"/>
                        </HorizontalStackLayout>

                        <Label VerticalOptions="Center" TextColor="{StaticResource InkColor}" Grid.Column="1" Text="15 дней"/>
                    </Grid>
                </Border>

                <!-- Максимальное кол-во выпитого кофеина -->
                <Border
                    Background="{StaticResource White}"
                    Stroke="{StaticResource DividerColor}"
                    StrokeThickness="1"
                    StrokeShape="20"
                    Padding="15,20">
                    <Grid ColumnDefinitions="*,Auto">

                        <HorizontalStackLayout Spacing="10">
                            <Image WidthRequest="24" 
                                HeightRequest="24" 
                                Source="record_ico.png"/>

                            <Label TextColor="{StaticResource InkColor}" 
                                Grid.Column="0" 
                                VerticalOptions="Center"
                                Text="Больше всего выпили в день:"/>
                        </HorizontalStackLayout>

                        <Label VerticalOptions="Center" TextColor="{StaticResource InkColor}" Grid.Column="1" Text="315 мг."/>
                    </Grid>
                </Border>

                <!-- Статистика источников кофеина -->
                <Border
                    Padding="15,20"
                    BackgroundColor="{StaticResource SurfaceColor}"
                    Stroke="{StaticResource DividerColor}"
                    StrokeShape="RoundRectangle 25"
                    StrokeThickness="1">
                    <VerticalStackLayout Spacing="16">
                        <controls:WeeklyConsumptionChartView ItemsSource="{Binding WeeklyDays}" />

                        <HorizontalStackLayout HorizontalOptions="Start" Spacing="20">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <BoxView BackgroundColor="{StaticResource CaffeeIcoFill}" CornerRadius="5" HeightRequest="10" VerticalOptions="Center" WidthRequest="10" />
                                <Label FontSize="12" Text="{localization:Translate Coffee}" TextColor="{StaticResource MutedTextColor}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <BoxView BackgroundColor="{StaticResource TeaIcoFill}" CornerRadius="5" HeightRequest="10" VerticalOptions="Center" WidthRequest="10" />
                                <Label FontSize="12" Text="{localization:Translate Tea}" TextColor="{StaticResource MutedTextColor}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <BoxView BackgroundColor="{StaticResource EnergyDrinkIcoFill}" CornerRadius="5" HeightRequest="10" VerticalOptions="Center" WidthRequest="10" />
                                <Label FontSize="12" Text="{localization:Translate EnergyDrinks}" TextColor="{StaticResource MutedTextColor}" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label
                    IsVisible="{Binding HasLoadError}"
                    HorizontalTextAlignment="Center"
                    Text="{Binding LoadError}"
                    TextColor="{StaticResource ValidationErrorColor}" />

                <!-- Кнопка "Месячная сводка" -->
                <Border 
                    Background="{StaticResource White}"
                    Stroke="{StaticResource DividerColor}"
                    StrokeThickness="1"
                    StrokeShape="20"
                    Padding="25,20">
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Image WidthRequest="32" HeightRequest="32" Source="monthly_summary.png"/>
                            <Label TextColor="{StaticResource InkColor}" 
                                Text="Месячная сводка"
                                FontSize="16"
                                FontAttributes="Bold"
                                VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNavigationBar
            Grid.Row="2"
            BindingContext="{Binding Navigation}"
            HorizontalOptions="Center"
            VerticalOptions="Start"
            ZIndex="20">
        </controls:BottomNavigationBar>
    </Grid>
</ContentPage>
