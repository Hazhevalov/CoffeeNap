<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CoffeeNap.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:CoffeeNap.Resources.Localization"
    xmlns:controls="clr-namespace:CoffeeNap.Controls"
    xmlns:viewModels="clr-namespace:CoffeeNap.ViewModels"
    x:DataType="viewModels:MainPageViewModel"
    AutomationId="MainTabContent"
    BackgroundColor="{StaticResource PageBackgroundColor}">

    <Grid SafeAreaEdges="None" RowDefinitions="Auto,Auto,*" RowSpacing="10" Padding="12,0">
        <controls:MainHeaderView Grid.Row="0" MinimumHeightRequest="86" BindingContext="{Binding Header}" SafeAreaEdges="None" />
        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding HasLoadError}" Spacing="4">
            <Label Text="{Binding InitializationError}" TextColor="{StaticResource InkColor}" />
            <Button Text="{localization:Translate Retry}" Command="{Binding RetryCommand}" />
        </VerticalStackLayout>
        <controls:ConsumptionPanel
            x:Name="ConsumptionPanel" Grid.Row="2"
            DeleteCommand="{Binding DeleteConsumptionCommand}"
            LoadMoreCommand="{Binding LoadMoreCommand}"
            HasMore="{Binding HasMore}" IsLoading="{Binding IsBusy}"
            ItemsSource="{Binding Consumptions}">
            <controls:ConsumptionPanel.HeaderContent>
                <VerticalStackLayout
            Spacing="10"
            VerticalOptions="Start">
            
            <!-- Блок "Дневная норма кофеина" -->
            <Border
                MinimumHeightRequest="150"
                Padding="15,20"
                BackgroundColor="{StaticResource InkColor}"
                StrokeThickness="0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="25" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow
                        Brush="{StaticResource CardShadowBrush}"
                        Offset="0,2"
                        Opacity="0.16"
                        Radius="6" />
                </Border.Shadow>

                <Grid SafeAreaEdges="None" RowSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid SafeAreaEdges="None" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="22" />
                        </Grid.ColumnDefinitions>

                        <Label
                            FontFamily="Inter"
                            FontSize="20"
                            FontAttributes="Bold"
                            LineHeight="1.2"
                            Text="{localization:Translate DailyCaffeineLimit}"
                            TextColor="{StaticResource SurfaceColor}" />
                    </Grid>

                    <Grid SafeAreaEdges="None"
                        Grid.Row="1"
                        ColumnSpacing="7">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Прогресс бар -->
                        <controls:RoundedProgressBar
                            HeightRequest="15"
                            VerticalOptions="Center"
                            Progress="{Binding DailyProgress}"
                            ProgressColor="{Binding DailyProgressColor}"
                            TrackColor="{StaticResource ProgressTrackColor}" />
                        
                        <Label
                            Grid.Column="1"
                            FontFamily="Inter"
                            FontSize="10"
                            Text="{Binding DailyLimitDisplay}"
                            TextColor="{StaticResource MutedTextColor}"
                            VerticalOptions="Center" />
                    </Grid>

                    <Label
                        Grid.Row="2"
                        FontFamily="Inter"
                        LineHeight="1"
                        TextColor="{StaticResource SurfaceColor}"
                        VerticalTextAlignment="End">

                        <Label.FormattedText>
                            <FormattedString>
                                <Span
                                    FontSize="32"
                                    FontAttributes="Bold"
                                    Text="{Binding CurrentCaffeine, StringFormat='{0:0}'}" />
                                <Span
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    Text="{localization:Translate Milligrams}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Grid>
            </Border>

            <!-- Блок "Ваши источники кофеина" -->
            <Border
                Padding="15,20"
                BackgroundColor="{StaticResource SurfaceColor}"
                Stroke="{StaticResource DividerColor}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="25" />
                </Border.StrokeShape>
                
                <Grid SafeAreaEdges="None" RowSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Заголовок блока и кнопка перехода -->
                    <Grid SafeAreaEdges="None" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="22" />
                        </Grid.ColumnDefinitions>

                        <Label
                            FontFamily="Inter"
                            FontSize="20"
                            FontAttributes="Bold"
                            LineHeight="1.1"
                            Text="{localization:Translate CaffeineSources}"
                            TextColor="{StaticResource InkColor}" />

                        <Image
                            Grid.Column="1"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Source="more_black_ico.png" />
                    </Grid>

                    <!-- Полосы статистики -->
                    <Border
                        Grid.Row="1"
                        BackgroundColor="{StaticResource DividerColor}"
                        StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Grid SafeAreaEdges="None" ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="{Binding CoffeeSource.SegmentWidth}" />
                                <ColumnDefinition
                                    Width="{Binding TeaSource.SegmentWidth}" />
                                <ColumnDefinition
                                    Width="{Binding EnergyDrinkSource.SegmentWidth}" />
                            </Grid.ColumnDefinitions>

                            <!-- Легенда блока -->
                            <!-- Кофе -->
                            <Grid SafeAreaEdges="None"
                                Grid.Column="0"
                                BackgroundColor="{Binding CoffeeSource.Color}"
                                IsClippedToBounds="True">

                                <Label
                                    Margin="0"
                                    Padding="3"
                                    FontFamily="Inter"
                                    FontSize="9"
                                    HorizontalTextAlignment="End"
                                    IsVisible="{Binding CoffeeSource.IsPercentageVisible}"
                                    LineBreakMode="NoWrap"
                                    MaxLines="1"
                                    Text="{Binding CoffeeSource.PercentageDisplay}"
                                    TextColor="{StaticResource SurfaceColor}"
                                    VerticalTextAlignment="Center" />
                            </Grid>

                            <!-- Чой -->
                            <Grid SafeAreaEdges="None"
                                Grid.Column="1"
                                BackgroundColor="{Binding TeaSource.Color}"
                                IsClippedToBounds="True">

                                <Label
                                    Margin="0"
                                    Padding="3"
                                    FontFamily="Inter"
                                    FontSize="9"
                                    HorizontalTextAlignment="End"
                                    IsVisible="{Binding TeaSource.IsPercentageVisible}"
                                    LineBreakMode="NoWrap"
                                    MaxLines="1"
                                    Text="{Binding TeaSource.PercentageDisplay}"
                                    TextColor="{StaticResource SurfaceColor}"
                                    VerticalTextAlignment="Center" />
                            </Grid>

                            <!-- Энергетик -->
                            <Grid SafeAreaEdges="None"
                                Grid.Column="2"
                                BackgroundColor="{Binding EnergyDrinkSource.Color}"
                                IsClippedToBounds="True">

                                <Label
                                    Margin="0"
                                    Padding="3"
                                    FontFamily="Inter"
                                    FontSize="9"
                                    HorizontalTextAlignment="End"
                                    IsVisible="{Binding EnergyDrinkSource.IsPercentageVisible}"
                                    LineBreakMode="NoWrap"
                                    MaxLines="1"
                                    Text="{Binding EnergyDrinkSource.PercentageDisplay}"
                                    TextColor="{StaticResource SurfaceColor}"
                                    VerticalTextAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid SafeAreaEdges="None"
                        Grid.Row="2"
                        ColumnSpacing="15">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <HorizontalStackLayout
                            Grid.Column="0"
                            Spacing="5">
                            
                            <BoxView
                                WidthRequest="8"
                                HeightRequest="8"
                                BackgroundColor="{Binding CoffeeSource.Color}"
                                CornerRadius="4"
                                VerticalOptions="Center" />
                                
                            <Label
                                FontFamily="Inter"
                                FontSize="10"
                                Text="{Binding CoffeeSource.Name}"
                                TextColor="{StaticResource MutedTextColor}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout
                            Grid.Column="1"
                            Spacing="5">

                            <BoxView
                                WidthRequest="8"
                                HeightRequest="8"
                                BackgroundColor="{Binding TeaSource.Color}"
                                CornerRadius="4"
                                VerticalOptions="Center" />

                            <Label
                                FontFamily="Inter"
                                FontSize="10"
                                Text="{Binding TeaSource.Name}"
                                TextColor="{StaticResource MutedTextColor}"
                                VerticalOptions="Center" />

                        </HorizontalStackLayout>

                        <HorizontalStackLayout
                            Grid.Column="2"
                            Spacing="5">

                            <BoxView
                                WidthRequest="8"
                                HeightRequest="8"
                                BackgroundColor="{Binding EnergyDrinkSource.Color}"
                                CornerRadius="4"
                                VerticalOptions="Center" />

                            <Label
                                FontFamily="Inter"
                                FontSize="10"
                                LineBreakMode="TailTruncation"
                                Text="{Binding EnergyDrinkSource.Name}"
                                TextColor="{StaticResource MutedTextColor}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>
                </Grid>
            </Border>
        </VerticalStackLayout>
            </controls:ConsumptionPanel.HeaderContent>
        </controls:ConsumptionPanel>
    </Grid>
</ContentView>
