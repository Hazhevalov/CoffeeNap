<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CoffeeNap.Controls.ConsumptionPanel"
    x:Name="Panel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:CoffeeNap.Behaviors"
    xmlns:controls="clr-namespace:CoffeeNap.Controls"
    xmlns:localization="clr-namespace:CoffeeNap.Resources.Localization"
    xmlns:viewModels="clr-namespace:CoffeeNap.ViewModels"
    BackgroundColor="Transparent">

    <!-- Белая карточка занимает всю доступную высоту фиксированного блока. -->
    <Border
        Padding="0"
        BackgroundColor="{StaticResource SurfaceColor}"
        StrokeThickness="1"
        Stroke="{StaticResource DividerColor}">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="30"/>
        </Border.StrokeShape>

        <Border.Shadow>
            <Shadow Brush="{StaticResource CardShadowBrush}" Offset="0,-2" Opacity="0.1" Radius="6" />
        </Border.Shadow>

        <Grid RowSpacing="0">
            <!-- Заголовок остаётся на месте, список занимает остальную высоту. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="10,16,10,10">
                <!-- Заголовок панели и декоративный информационный значок. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="26" />
                </Grid.ColumnDefinitions>
                <Label
                    FontFamily="Inter"
                    FontSize="20"
                    FontAttributes="Bold"
                    Text="{localization:Translate Consumptions}"
                    TextColor="{StaticResource InkColor}" />
                <Image Source="info_ico.png" 
                       WidthRequest="24" 
                       HeightRequest="24"
                       HorizontalOptions="End"
                       VerticalOptions="Center"
                       Grid.Column="1"/>
            </Grid>

            <Grid Grid.Row="1">
                <!-- Список получает данные снаружи через ItemsSource самого контрола. -->
                <CollectionView
                    x:Name="ConsumptionList"
                    Margin="0,1,0,0"
                    BackgroundColor="{StaticResource SurfaceColor}"
                    ItemsSource="{Binding Source={x:Reference Panel}, Path=ItemsSource}"
                    SelectionMode="None"
                    VerticalScrollBarVisibility="Never">
                    <CollectionView.EmptyView>
                        <Grid Padding="20" VerticalOptions="Center">
                            <Label
                                FontFamily="Inter"
                                FontSize="14"
                                HorizontalTextAlignment="Center"
                                Text="{localization:Translate EmptyConsumptions}"
                                TextColor="{StaticResource MutedTextColor}"
                                VerticalTextAlignment="Center" />
                        </Grid>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <!-- x:DataType включает проверку привязок элемента при компиляции. -->
                        <DataTemplate x:DataType="viewModels:ConsumptionItemViewModel">
                            <SwipeView
                                BindingContextChanged="OnSwipeBindingContextChanged"
                                SwipeEnded="OnSwipeEnded"
                                SwipeStarted="OnSwipeStarted">
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal">
                                        <SwipeItemView>
                                            <Border
                                                Margin="0,3,10,3"
                                                Padding="18"
                                                BackgroundColor="{StaticResource CaffeineProgressLimit}"
                                                StrokeThickness="0"
                                                WidthRequest="72">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="16" />
                                                </Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type controls:ConsumptionPanel}}, Path=DeleteCommand}"
                                                        CommandParameter="{Binding .}"
                                                        Tapped="OnDeleteActionTapped" />
                                                </Border.GestureRecognizers>
                                                <Border.Behaviors>
                                                    <behaviors:PressAnimationBehavior PressedScale="0.94" />
                                                </Border.Behaviors>
                                                <Image
                                                    Aspect="AspectFit"
                                                    HeightRequest="64"
                                                    InputTransparent="True"
                                                    Source="trash.png"
                                                    WidthRequest="64" />
                                            </Border>
                                        </SwipeItemView>
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Border
                                    Margin="10,3"
                                    MinimumHeightRequest="64"
                                    Padding="10"
                                    BackgroundColor="{StaticResource SurfaceColor}"
                                    Stroke="{StaticResource DividerColor}"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="{StaticResource CardShadowBrush}" Offset="0,1" Opacity="0.06" Radius="3" />
                                    </Border.Shadow>
                                    <Grid ColumnSpacing="10">
                                        <!-- Карточка записи: иконка, название/время и доза кофеина. -->
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            WidthRequest="44"
                                            HeightRequest="44"
                                            Padding="10"
                                            BackgroundColor="{Binding IconBackground}"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="22" />
                                            </Border.StrokeShape>
                                            <Image Source="{Binding Icon}" Aspect="AspectFit" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label
                                                FontFamily="Inter"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1"
                                                Text="{Binding Name}"
                                                TextColor="{StaticResource InkColor}" />
                                        <Label
                                            FontFamily="Inter"
                                                FontSize="11"
                                                Text="{Binding RelativeTime}"
                                                TextColor="{StaticResource MutedTextColor}" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="2"
                                            Margin="4,0,0,0"
                                            FontFamily="Inter"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            Text="{Binding CaffeineDisplay}"
                                            TextColor="{StaticResource InkColor}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <!-- Фиксированный отступ позволяет полностью показать последнюю карточку. -->
                    <CollectionView.Footer>
                        <BoxView
                            x:Name="BottomScrollSpacer"
                            HeightRequest="20"
                            BackgroundColor="{StaticResource SurfaceColor}" />
                    </CollectionView.Footer>
                </CollectionView>
            </Grid>
        </Grid>
    </Border>
</ContentView>
