<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CoffeeNap.Controls.ConsumptionPanel"
    x:Name="Panel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:CoffeeNap.Behaviors"
    xmlns:controls="clr-namespace:CoffeeNap.Controls"
    xmlns:localization="clr-namespace:CoffeeNap.Resources.Localization"
    xmlns:viewModels="clr-namespace:CoffeeNap.ViewModels"
    BackgroundColor="Transparent">

    <!-- Fixed card and header; only the history list scrolls. -->
    <Border Padding="5"
        BackgroundColor="{StaticResource SurfaceColor}"
        Stroke="{StaticResource DividerColor}" StrokeThickness="1">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="25" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="{StaticResource CardShadowBrush}" Offset="0,-2" Opacity="0.1" Radius="6" />
        </Border.Shadow>
        <Grid RowDefinitions="Auto,*" RowSpacing="0">
            <Grid Padding="10,16,10,10" ColumnDefinitions="*,26" ColumnSpacing="8">
                <Label FontFamily="Inter" FontSize="20" FontAttributes="Bold"
                    Text="{localization:Translate Consumptions}" TextColor="{StaticResource InkColor}" />
                <Image Grid.Column="1" Source="info_ico.png"
                    WidthRequest="24" HeightRequest="24"
                    HorizontalOptions="End" VerticalOptions="Center" />
            </Grid>
                <CollectionView Grid.Row="1"
                    x:Name="ConsumptionList"
                    Margin="0,1,0,0"
                    BackgroundColor="{StaticResource SurfaceColor}"
                    ItemsSource="{Binding Source={x:Reference Panel}, Path=ItemsSource}"
                    SelectionMode="None"
                    ItemSizingStrategy="MeasureFirstItem"
                    ItemsUpdatingScrollMode="KeepScrollOffset"
                    Scrolled="OnScrolled"
                    RemainingItemsThreshold="8"
                    RemainingItemsThresholdReachedCommand="{Binding Source={x:Reference Panel}, Path=LoadMoreCommand}"
                    VerticalScrollBarVisibility="Never">

                    <CollectionView.EmptyView>
                        <Grid Padding="20" VerticalOptions="Center">
                            <Label
                                FontFamily="Inter"
                                FontSize="14"
                                HorizontalTextAlignment="Center"
                                Text="{localization:Translate EmptyConsumptions}"
                                TextColor="{StaticResource MutedTextColor}"
                                VerticalTextAlignment="Center" />
                        </Grid>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <!-- x:DataType enables compile-time validation of item bindings. -->
                        <DataTemplate x:DataType="viewModels:ConsumptionItemViewModel">
                            <SwipeView
                                BindingContextChanged="OnSwipeBindingContextChanged"
                                SwipeEnded="OnSwipeEnded"
                                SwipeStarted="OnSwipeStarted">

                                <!-- Row with a right-swipe action. -->
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal">
                                        <SwipeItemView>
                                            <Border
                                                Margin="10,3,10,3"
                                                Padding="18"
                                                BackgroundColor="{StaticResource CaffeineProgressLimit}"
                                                StrokeThickness="0"
                                                WidthRequest="64"
                                                HeightRequest="64">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="20" />
                                                </Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type controls:ConsumptionPanel}}, Path=DeleteCommand}"
                                                        CommandParameter="{Binding .}"
                                                        Tapped="OnDeleteActionTapped" />
                                                </Border.GestureRecognizers>
                                                <Border.Behaviors>
                                                    <behaviors:PressAnimationBehavior PressedScale="0.94" />
                                                </Border.Behaviors>
                                                <Image
                                                    Aspect="AspectFit"
                                                    HeightRequest="24"
                                                    WidthRequest="24"
                                                    InputTransparent="True"
                                                    Source="trash.png" />
                                            </Border>
                                        </SwipeItemView>
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Border
                                    Margin="10,3"
                                    MinimumHeightRequest="64"
                                    Padding="10"
                                    BackgroundColor="{StaticResource SurfaceColor}"
                                    Stroke="{StaticResource DividerColor}"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>

                                    <Grid ColumnSpacing="10">
                                        <!-- Consumption card: icon, name, time, and caffeine dose. -->
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            WidthRequest="44"
                                            HeightRequest="44"
                                            Padding="10"
                                            BackgroundColor="{Binding IconBackground}"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            <Image Source="{Binding Icon}" Aspect="AspectFit" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label
                                                FontFamily="Inter"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1"
                                                Text="{Binding Name}"
                                                TextColor="{StaticResource InkColor}" />
                                        <Label
                                            FontFamily="Inter"
                                                FontSize="11"
                                                MaxLines="1"
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding RelativeTime}"
                                                TextColor="{StaticResource MutedTextColor}" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="2"
                                            Margin="4,0,0,0"
                                            FontFamily="Inter"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            Text="{Binding CaffeineDisplay}"
                                            TextColor="{StaticResource InkColor}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <!-- Fixed spacing keeps the last card fully visible. -->
                    <CollectionView.Footer>
                        <VerticalStackLayout Padding="10,8,10,20" Spacing="6">
                            <ActivityIndicator IsRunning="{Binding Source={x:Reference Panel}, Path=IsLoading}"
                                IsVisible="{Binding Source={x:Reference Panel}, Path=IsLoading}" />
                            <Button Text="{localization:Translate LoadMore}"
                                IsVisible="{Binding Source={x:Reference Panel}, Path=HasMore}"
                                Command="{Binding Source={x:Reference Panel}, Path=LoadMoreCommand}" />
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                </CollectionView>
        </Grid>
    </Border>
</ContentView>
