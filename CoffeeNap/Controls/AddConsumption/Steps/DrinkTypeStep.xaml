<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CoffeeNap.Controls.AddConsumption.Steps.DrinkTypeStep"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:CoffeeNap.Resources.Localization"
    xmlns:models="clr-namespace:CoffeeNap.Models"
    xmlns:viewModels="clr-namespace:CoffeeNap.ViewModels"
    x:DataType="viewModels:AddConsumptionPageViewModel">
    <!-- Drink category selection. -->
            <!-- Content grid excluding the header and navigation bar. -->
            <Grid
                Grid.Row="1"
                Padding="10"
                RowSpacing="20"
                VerticalOptions="Fill">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Quiz and action container. -->
                <Grid Grid.Row="0" VerticalOptions="Fill">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Quiz and action grid. -->
                    <Grid
                        Grid.Row="1"
                        IsVisible="True"
                        VerticalOptions="Fill">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Drink selection section. -->
                        <Grid
                            Grid.Row="0"
                            HorizontalOptions="Fill"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="20"
                            VerticalOptions="Center">

                            <!-- Heading. -->
                            <Label
                                Grid.Row="0"
                                FontAttributes="Bold"
                                FontSize="32"
                                HorizontalOptions="Start"
                                Text="{localization:Translate DrinkQuestion}"
                                TextColor="{StaticResource InkColor}"
                                VerticalOptions="Start" />

                            <!-- Selection cards. -->
                            <Grid
                                Grid.Row="1"
                                ColumnDefinitions="*,*,*"
                                ColumnSpacing="5"
                                HorizontalOptions="Fill"
                                VerticalOptions="Start">

                                <!-- Coffee. -->
                                <Border
                                    Grid.Column="0"
                                    Padding="16"
                                    BackgroundColor="{StaticResource White}"
                                    Stroke="{StaticResource DividerColor}"
                                    StrokeThickness="1">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding SelectDrinkTypeCommand}"
                                            CommandParameter="{x:Static models:CaffeineConsumptionType.Coffee}" />
                                    </Border.GestureRecognizers>

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout
                                        HorizontalOptions="Center"
                                        Spacing="10"
                                        VerticalOptions="Center">

                                        <Border
                                            BackgroundColor="{StaticResource CaffeeIcoFill}"
                                            HeightRequest="56"
                                            StrokeThickness="0"
                                            WidthRequest="56">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="28" />
                                            </Border.StrokeShape>

                                            <Image
                                                Aspect="AspectFit"
                                                HeightRequest="32"
                                                Source="coffee_ico.png"
                                                WidthRequest="32" />
                                        </Border>

                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            HorizontalTextAlignment="Center"
                                            Text="{localization:Translate Coffee}"
                                            TextColor="{StaticResource InkColor}" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Energy drink. -->
                                <Border
                                    Grid.Column="1"
                                    Padding="16"
                                    BackgroundColor="{StaticResource White}"
                                    Stroke="{StaticResource DividerColor}"
                                    StrokeThickness="1">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding SelectDrinkTypeCommand}"
                                            CommandParameter="{x:Static models:CaffeineConsumptionType.EnergyDrink}" />
                                    </Border.GestureRecognizers>

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout
                                        HorizontalOptions="Center"
                                        Spacing="10"
                                        VerticalOptions="Center">

                                        <Border
                                            BackgroundColor="{StaticResource EnergyDrinkIcoFill}"
                                            HeightRequest="56"
                                            StrokeThickness="0"
                                            WidthRequest="56">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="28" />
                                            </Border.StrokeShape>

                                            <Image
                                                Aspect="AspectFit"
                                                HeightRequest="32"
                                                Source="energy_drink_ico.png"
                                                WidthRequest="32" />
                                        </Border>

                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            HorizontalTextAlignment="Center"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="1"
                                            Text="{localization:Translate EnergyDrink}"
                                            TextColor="{StaticResource InkColor}" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Tea. -->
                                <Border
                                    Grid.Column="2"
                                    Padding="16"
                                    BackgroundColor="{StaticResource White}"
                                    Stroke="{StaticResource DividerColor}"
                                    StrokeThickness="1">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding SelectDrinkTypeCommand}"
                                            CommandParameter="{x:Static models:CaffeineConsumptionType.Tea}" />
                                    </Border.GestureRecognizers>

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout
                                        HorizontalOptions="Center"
                                        Spacing="10"
                                        VerticalOptions="Center">

                                        <Border
                                            BackgroundColor="{StaticResource TeaIcoFill}"
                                            HeightRequest="56"
                                            StrokeThickness="0"
                                            WidthRequest="56">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="28" />
                                            </Border.StrokeShape>

                                            <Image
                                                Aspect="AspectFit"
                                                HeightRequest="32"
                                                Source="tea_ico.png"
                                                WidthRequest="32" />
                                        </Border>

                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            HorizontalTextAlignment="Center"
                                            Text="{localization:Translate Tea}"
                                            TextColor="{StaticResource InkColor}" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Reuse the last recipe. -->
                        <Border
                            Grid.Row="1"
                            Stroke="{StaticResource DividerColor}"
                            StrokeThickness="1"
                            VerticalOptions="End">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>

                            <Button
                                Padding="25"
                                BackgroundColor="{StaticResource White}"
                                Command="{Binding UseLastRecipeCommand}"
                                FontAttributes="Bold"
                                FontSize="16"
                                HorizontalOptions="Fill"
                                Text="{localization:Translate UseOldRecipe}"
                                TextColor="{StaticResource InkColor}"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
</ContentView>
