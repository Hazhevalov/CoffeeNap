<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CoffeeNap.Controls.AddConsumption.Steps.ConsumptionResultStep"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CoffeeNap.Models"
    xmlns:viewModels="clr-namespace:CoffeeNap.ViewModels"
    x:DataType="viewModels:AddConsumptionPageViewModel">
<!--  Результат!  -->
            <Grid
                Grid.Row="1"
                Padding="10,10,10,0"
                IsVisible="{Binding IsResultStep}"
                RowSpacing="20"
                VerticalOptions="Fill">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    RowSpacing="10"
                    VerticalOptions="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Заголовки  -->
                    <Grid Grid.Row="0" RowSpacing="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label
                            Grid.Row="0"
                            FontSize="16"
                            Text="{Binding ResultContext}"
                            TextColor="{StaticResource MutedTextColor}" />

                        <Label
                            Grid.Row="1"
                            FontAttributes="Bold"
                            FontSize="32"
                            Text="Результат!"
                            TextColor="{StaticResource InkColor}" />
                    </Grid>

                    <!--  Суммирующий блок  -->
                    <Border
                        Grid.Row="1"
                        Padding="25,25"
                        Background="{StaticResource White}"
                        Stroke="{StaticResource DividerColor}">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <Grid RowSpacing="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Заголовок  -->
                            <Label
                                Grid.Row="0"
                                FontAttributes="Bold"
                                FontSize="24"
                                Text="{Binding ResultName}"
                                TextColor="{StaticResource InkColor}" />

                            <!--  Список  -->
                            <VerticalStackLayout Grid.Row="1" Spacing="10">
                                <!--  Параметр  -->
                                <Label
                                    FontSize="16"
                                    Text="{Binding ResultDetail1}"
                                    TextColor="{StaticResource InkColor}" />

                                <!--  Параметр + значение  -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Label
                                        Grid.Column="0"
                                        FontSize="16"
                                        Text="{Binding ResultDetail2}"
                                        TextColor="{StaticResource InkColor}" />
                                    <Label
                                        Grid.Column="1"
                                        FontSize="16"
                                        Text="{Binding ResultDetail2Value}"
                                        TextColor="{StaticResource MutedTextColor}" />
                                </Grid>

                                <!--  Параметр  -->
                                <Label
                                    FontSize="16"
                                    Text="{Binding ResultDetail3}"
                                    TextColor="{StaticResource InkColor}" />

                                <!--  Параметр + значение  -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Label
                                        Grid.Column="0"
                                        FontSize="16"
                                        Text="{Binding ResultDetail4}"
                                        TextColor="{StaticResource InkColor}" />
                                    <Label
                                        Grid.Column="1"
                                        FontSize="16"
                                        Text="{Binding ResultDetail4Value}"
                                        TextColor="{StaticResource MutedTextColor}" />
                                </Grid>
                            </VerticalStackLayout>

                            <!--  Итог  -->
                            <Grid
                                Grid.Row="2"
                                Grid.Column="0"
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="12">
                                <Label
                                    Grid.Column="0"
                                    FontSize="24"
                                    Text="Итого:"
                                    TextColor="{StaticResource InkColor}" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="24"
                                    Text="{Binding ResultCaffeine}"
                                    TextColor="{StaticResource InkColor}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!--  Изменить данные  -->
                    <Grid Grid.Row="2">
                        <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                            <Button
                                BackgroundColor="{StaticResource White}"
                                BorderWidth="0"
                                CornerRadius="20"
                                FontSize="16"
                                HorizontalOptions="Fill"
                                MaximumHeightRequest="56"
                                Command="{Binding RestartQuizCommand}"
                                Text="Изменить данные"
                                TextColor="{StaticResource InkColor}" />

                            <Label
                                FontSize="16"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="или"
                                TextColor="{StaticResource MutedTextColor}" />

                            <Button
                                BackgroundColor="{StaticResource InkColor}"
                                BorderWidth="0"
                                CornerRadius="20"
                                FontSize="16"
                                HorizontalOptions="Fill"
                                MaximumHeightRequest="56"
                                Command="{Binding SaveConsumptionCommand}"
                                Text="Сохранить и выпить"
                                TextColor="{StaticResource White}" />

                        </VerticalStackLayout>
                    </Grid>
                </Grid>
            </Grid>
</ContentView>
