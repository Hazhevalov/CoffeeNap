<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CoffeeNap.Controls.AddConsumption.Steps.ConsumptionResultStep"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:CoffeeNap.Resources.Localization"
    xmlns:models="clr-namespace:CoffeeNap.Models"
    xmlns:viewModels="clr-namespace:CoffeeNap.ViewModels"
    x:DataType="viewModels:AddConsumptionPageViewModel">
    <!-- Calculation result. -->
    <Grid
        Grid.Row="1"
        Padding="10,10,10,0"
        RowSpacing="20"
        VerticalOptions="Fill">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            RowSpacing="10"
            VerticalOptions="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Headings. -->
            <Grid Grid.Row="0" RowSpacing="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label
                    Grid.Row="0"
                    FontSize="16"
                    Text="{Binding ResultContext}"
                    TextColor="{StaticResource MutedTextColor}" />

                <Label
                    Grid.Row="1"
                    FontAttributes="Bold"
                    FontSize="32"
                    Text="{localization:Translate Result}"
                    TextColor="{StaticResource InkColor}" />
            </Grid>

            <!-- Summary panel. -->
            <Border
                Grid.Row="1"
                Padding="25,25"
                Background="{StaticResource White}"
                Stroke="{StaticResource DividerColor}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <Grid RowSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Heading. -->
                    <Label
                        Grid.Row="0"
                        FontAttributes="Bold"
                        FontSize="24"
                        Text="{Binding ResultName}"
                        TextColor="{StaticResource InkColor}" />

                    <!-- List. -->
                    <VerticalStackLayout Grid.Row="1" Spacing="10">
                        <!-- Parameter label. -->
                        <Label
                            FontSize="14"
                            Text="{Binding ResultDetail1}"
                            TextColor="{StaticResource InkColor}" />

                        <!-- Parameter and value. -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label
                                Grid.Column="0"
                                FontSize="14"
                                Text="{Binding ResultDetail2}"
                                TextColor="{StaticResource InkColor}" />
                            <Label
                                Grid.Column="1"
                                FontSize="14"
                                Text="{Binding ResultDetail2Value}"
                                TextColor="{StaticResource MutedTextColor}" />
                        </Grid>

                        <!-- Parameter label. -->
                        <Label
                            FontSize="14"
                            Text="{Binding ResultDetail3}"
                            TextColor="{StaticResource InkColor}" />

                        <!-- Parameter and value. -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label
                                Grid.Column="0"
                                FontSize="14"
                                Text="{Binding ResultDetail4}"
                                TextColor="{StaticResource InkColor}" />
                            <Label
                                Grid.Column="1"
                                FontSize="14"
                                Text="{Binding ResultDetail4Value}"
                                TextColor="{StaticResource MutedTextColor}" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Total. -->
                    <Grid
                        Grid.Row="2"
                        Grid.Column="0"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="12">
                        <Label
                            Grid.Column="0"
                            FontSize="20"
                            Text="{localization:Translate Total}"
                            TextColor="{StaticResource InkColor}" />
                        <Label
                            Grid.Column="1"
                            FontSize="20"
                            Text="{Binding ResultCaffeine}"
                            TextColor="{StaticResource InkColor}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Edit answers. -->
            <Grid Grid.Row="2">
                <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                    <Button
                        BackgroundColor="{StaticResource White}"
                        BorderWidth="0"
                        Command="{Binding RestartQuizCommand}"
                        CornerRadius="20"
                        FontSize="16"
                        HorizontalOptions="Fill"
                        HeightRequest="56"
                        Text="{localization:Translate EditData}"
                        TextColor="{StaticResource InkColor}" />

                    <Label
                        FontSize="16"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="{localization:Translate Or}"
                        TextColor="{StaticResource MutedTextColor}" />

                    <Button
                        BackgroundColor="{StaticResource InkColor}"
                        BorderWidth="0"
                        Command="{Binding SaveConsumptionCommand}"
                        CornerRadius="20"
                        FontSize="16"
                        HorizontalOptions="Fill"
                        HeightRequest="56"
                        Text="{localization:Translate SaveAndDrink}"
                        TextColor="{StaticResource White}" />

                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentView>
