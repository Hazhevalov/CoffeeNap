<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CoffeeNap.Controls.AddConsumption.Steps.CoffeeDrinkTypeStep"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:CoffeeNap.Resources.Localization"
    xmlns:models="clr-namespace:CoffeeNap.Models"
    xmlns:viewModels="clr-namespace:CoffeeNap.ViewModels"
    x:DataType="viewModels:AddConsumptionPageViewModel">
<!-- Cafe coffee: drink type. -->
            <Grid
                Grid.Row="1"
                Padding="10,10,10,0"
                RowSpacing="20"
                VerticalOptions="Fill">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    RowSpacing="20"
                    VerticalOptions="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Headings. -->
                    <Grid Grid.Row="0" RowSpacing="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label
                            Grid.Row="0"
                            FontSize="16"
                            Text="{localization:Translate OutsideCoffee}"
                            TextColor="{StaticResource MutedTextColor}" />

                        <Label
                            Grid.Row="1"
                            FontAttributes="Bold"
                            FontSize="32"
                            Text="{localization:Translate DrinkTypeQuestion}"
                            TextColor="{StaticResource InkColor}" />

                        <Label
                            Grid.Row="2"
                            FontSize="16"
                            Text="{localization:Translate EnjoyedHint}"
                            TextColor="{StaticResource InkColor}" />
                    </Grid>

                    <!-- Drink type selection cards. -->
                    <FlexLayout
                        Grid.Row="1"
                        AlignContent="Start"
                        AlignItems="Start"
                        Direction="Row"
                        JustifyContent="Start"
                        Wrap="Wrap">

                        <Button
                            Margin="2"
                            BackgroundColor="{StaticResource White}"
                            BorderColor="{StaticResource DividerColor}"
                            BorderWidth="1"
                            CornerRadius="15"
                            FontSize="16"
                            Command="{Binding SelectCoffeeDrinkTypeCommand}"
                            CommandParameter="{x:Static models:CoffeeDrinkType.Espresso}"
                            Text="{localization:Translate Espresso}"
                            TextColor="{StaticResource InkColor}" />

                        <Button
                            Margin="2"
                            BackgroundColor="{StaticResource White}"
                            BorderColor="{StaticResource DividerColor}"
                            BorderWidth="1"
                            CornerRadius="15"
                            FontSize="16"
                            Command="{Binding SelectCoffeeDrinkTypeCommand}"
                            CommandParameter="{x:Static models:CoffeeDrinkType.Macchiato}"
                            Text="{localization:Translate Macchiato}"
                            TextColor="{StaticResource InkColor}" />

                        <Button
                            Margin="2"
                            BackgroundColor="{StaticResource White}"
                            BorderColor="{StaticResource DividerColor}"
                            BorderWidth="1"
                            CornerRadius="15"
                            FontSize="16"
                            Command="{Binding SelectCoffeeDrinkTypeCommand}"
                            CommandParameter="{x:Static models:CoffeeDrinkType.Americano}"
                            Text="{localization:Translate Americano}"
                            TextColor="{StaticResource InkColor}" />

                        <Button
                            Margin="2"
                            BackgroundColor="{StaticResource White}"
                            BorderColor="{StaticResource DividerColor}"
                            BorderWidth="1"
                            CornerRadius="15"
                            FontSize="16"
                            Command="{Binding SelectCoffeeDrinkTypeCommand}"
                            CommandParameter="{x:Static models:CoffeeDrinkType.Cappuccino}"
                            Text="{localization:Translate Cappuccino}"
                            TextColor="{StaticResource InkColor}" />

                        <Button
                            Margin="2"
                            BackgroundColor="{StaticResource White}"
                            BorderColor="{StaticResource DividerColor}"
                            BorderWidth="1"
                            CornerRadius="15"
                            FontSize="16"
                            Command="{Binding SelectCoffeeDrinkTypeCommand}"
                            CommandParameter="{x:Static models:CoffeeDrinkType.Latte}"
                            Text="{localization:Translate Latte}"
                            TextColor="{StaticResource InkColor}" />

                        <Button
                            Margin="2"
                            BackgroundColor="{StaticResource White}"
                            BorderColor="{StaticResource DividerColor}"
                            BorderWidth="1"
                            CornerRadius="15"
                            FontSize="16"
                            Command="{Binding SelectCoffeeDrinkTypeCommand}"
                            CommandParameter="{x:Static models:CoffeeDrinkType.FlatWhite}"
                            Text="{localization:Translate FlatWhite}"
                            TextColor="{StaticResource InkColor}" />

                        <Button
                            Margin="2"
                            BackgroundColor="{StaticResource White}"
                            BorderColor="{StaticResource DividerColor}"
                            BorderWidth="1"
                            CornerRadius="15"
                            FontSize="16"
                            Command="{Binding SelectCoffeeDrinkTypeCommand}"
                            CommandParameter="{x:Static models:CoffeeDrinkType.Mocha}"
                            Text="{localization:Translate Mocha}"
                            TextColor="{StaticResource InkColor}" />

                        <Button
                            Margin="2"
                            BackgroundColor="{StaticResource White}"
                            BorderColor="{StaticResource DividerColor}"
                            BorderWidth="1"
                            CornerRadius="15"
                            FontSize="16"
                            Command="{Binding SelectCoffeeDrinkTypeCommand}"
                            CommandParameter="{x:Static models:CoffeeDrinkType.Affogato}"
                            Text="{localization:Translate Affogato}"
                            TextColor="{StaticResource InkColor}" />

                    </FlexLayout>
                </Grid>
            </Grid>
</ContentView>
