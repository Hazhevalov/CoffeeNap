<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CoffeeNap.Controls.AddConsumption.Steps.CoffeeAmountStep"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CoffeeNap.Models"
    xmlns:viewModels="clr-namespace:CoffeeNap.ViewModels"
    x:DataType="viewModels:AddConsumptionPageViewModel">
<!--  Home Option 2 "Сколько кофе"  -->
            <Grid
                Grid.Row="1"
                Padding="10,10,10,0"
                IsVisible="{Binding IsCoffeeAmountStep}"
                RowSpacing="20"
                VerticalOptions="Fill">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    RowSpacing="20"
                    VerticalOptions="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Заголовки  -->
                    <Grid Grid.Row="0" RowSpacing="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label
                            Grid.Row="0"
                            FontSize="16"
                            Text="Домашний кофе"
                            TextColor="{StaticResource MutedTextColor}" />

                        <Label
                            Grid.Row="1"
                            FontAttributes="Bold"
                            FontSize="32"
                            Text="Сколько кофе использовали?"
                            TextColor="{StaticResource InkColor}" />

                        <Label
                            Grid.Row="2"
                            FontSize="16"
                            Text="Можно примерно, это не проблема"
                            TextColor="{StaticResource InkColor}" />
                    </Grid>

                    <!--  Варианты выбора  -->
                    <Grid Grid.Row="1" RowSpacing="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Padding="16,12"
                            BackgroundColor="{StaticResource White}"
                            Stroke="{StaticResource DividerColor}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <Entry
                                BackgroundColor="{StaticResource White}"
                                ClearButtonVisibility="WhileEditing"
                                FontSize="16"
                                Keyboard="Numeric"
                                MaxLength="3"
                                Placeholder="Знаю граммы"
                                ReturnType="Next"
                                ReturnCommand="{Binding ConfirmManualCoffeeAmountCommand}"
                                Text="{Binding ManualCoffeeAmountText, Mode=TwoWay}"
                                TextColor="{StaticResource InkColor}" />
                        </Border>

                        <Border Grid.Row="1" Stroke="{StaticResource DividerColor}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>

                            <Button
                                Padding="0,25"
                                BackgroundColor="{StaticResource White}"
                                FontSize="16"
                                HorizontalOptions="Fill"
                                Command="{Binding SelectCoffeeAmountCommand}"
                                CommandParameter="{x:Static models:CoffeeQuizCatalog.One}"
                                Text="Одна ложка"
                                TextColor="{StaticResource InkColor}" />
                        </Border>

                        <Border Grid.Row="2" Stroke="{StaticResource DividerColor}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>

                            <Button
                                Padding="0,25"
                                BackgroundColor="{StaticResource White}"
                                FontSize="16"
                                HorizontalOptions="Fill"
                                Command="{Binding SelectCoffeeAmountCommand}"
                                CommandParameter="{x:Static models:CoffeeQuizCatalog.Two}"
                                Text="Две ложки"
                                TextColor="{StaticResource InkColor}" />
                        </Border>

                        <Border Grid.Row="3" Stroke="{StaticResource DividerColor}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>

                            <Button
                                Padding="0,25"
                                BackgroundColor="{StaticResource White}"
                                FontSize="16"
                                HorizontalOptions="Fill"
                                Command="{Binding SelectCoffeeAmountCommand}"
                                CommandParameter="{x:Static models:CoffeeQuizCatalog.Three}"
                                Text="Больше?"
                                TextColor="{StaticResource InkColor}" />
                        </Border>
                    </Grid>

                </Grid>
            </Grid>
</ContentView>
