<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CoffeeNap.Controls.AddConsumption.Steps.TeaSort"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:CoffeeNap.Resources.Localization"
    xmlns:models="clr-namespace:CoffeeNap.Models"
    xmlns:viewModels="clr-namespace:CoffeeNap.ViewModels"
    x:DataType="viewModels:AddConsumptionPageViewModel">

    <Grid Padding="10" VerticalOptions="Fill">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="20" VerticalOptions="Center">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="5">
                <Label FontSize="16" Text="{localization:Translate Tea}" TextColor="{StaticResource MutedTextColor}" />
                <Label Grid.Row="1" FontAttributes="Bold" FontSize="32" Text="{localization:Translate TeaSortQuestion}" TextColor="{StaticResource InkColor}" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
                <Border Grid.Column="0" Padding="16" BackgroundColor="{StaticResource White}" Stroke="{StaticResource DividerColor}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTeaTypeCommand}" CommandParameter="{x:Static models:TeaType.Black}" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="10" VerticalOptions="Center">
                        <Border BackgroundColor="{StaticResource CaffeeIcoFill}" HeightRequest="56" StrokeThickness="0" WidthRequest="56">
                            <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
                            <Image Aspect="AspectFit" HeightRequest="32" Source="black_tea_ico.png" WidthRequest="32" />
                        </Border>
                        <Label FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center" Text="{localization:Translate BlackTea}" TextColor="{StaticResource InkColor}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Padding="16" BackgroundColor="{StaticResource White}" Stroke="{StaticResource DividerColor}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTeaTypeCommand}" CommandParameter="{x:Static models:TeaType.Green}" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="10" VerticalOptions="Center">
                        <Border BackgroundColor="{StaticResource TeaIcoFill}" HeightRequest="56" StrokeThickness="0" WidthRequest="56">
                            <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
                            <Image Aspect="AspectFit" HeightRequest="32" Source="green_tea_ico.png" WidthRequest="32" />
                        </Border>
                        <Label FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center" Text="{localization:Translate GreenTea}" TextColor="{StaticResource InkColor}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentView>
