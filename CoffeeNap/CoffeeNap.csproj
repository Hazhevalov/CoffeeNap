<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Builds Android, iOS, and Mac Catalyst; Windows is included only on a Windows host. -->
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- MAUI notes on Mac Catalyst architectures:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<!-- Default namespace for files without an explicit RootNamespace. -->
		<RootNamespace>CoffeeNap</RootNamespace>
		<!-- Enables MAUI targets and shared resources through the Single Project model. -->
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<!-- Enables implicit standard imports and nullable reference analysis. -->
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Generate page/control construction code in both Debug and Release. -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Application name displayed to the user. -->
		<ApplicationTitle>CoffeeNap</ApplicationTitle>

		<!-- Stable package identifier used for installation and future updates. -->
		<ApplicationId>com.hazhevalov.coffeenap</ApplicationId>

		<!-- Public version and monotonically increasing internal build number. -->
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- None runs the Windows app without an MSIX package during development. -->
		<WindowsPackageType>None</WindowsPackageType>

		<!-- Minimum operating system versions supported for installation. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<!-- Produce an installable APK; signing credentials are supplied at publish time. -->
		<AndroidPackageFormats>apk</AndroidPackageFormats>
	</PropertyGroup>

	<ItemGroup>
		<!-- App icon: appicon.svg provides the background; appiconfg.svg is the adaptive foreground. -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#ffffff" />

		<!-- MAUI converts the splash screen into platform resources. -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#ffffff" BaseSize="128,128" />

		<!-- Images in this folder are available in XAML by file name. -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Fonts are packaged as MAUIFont; their aliases are registered in MauiProgram. -->
		<MauiFont Include="Resources\Fonts\*" />

	</ItemGroup>

	<ItemGroup>
		<!-- MVVM Toolkit generates commands and observable properties; other packages provide MAUI UI and debug logging. -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
	</ItemGroup>

</Project>
