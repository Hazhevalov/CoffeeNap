<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CoffeeNap.WelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:CoffeeNap.ViewModels"
    x:DataType="viewModels:WelcomeViewModel"
    BackgroundColor="{StaticResource PageBackgroundColor}"
    SafeAreaEdges="All"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Grid
        x:Name="WelcomePageContent"
        Padding="12,20,12,25"
        RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
            <BoxView
                WidthRequest="8"
                HeightRequest="8"
                BackgroundColor="{StaticResource InkColor}"
                CornerRadius="4" />
            <BoxView
                WidthRequest="8"
                HeightRequest="8"
                BackgroundColor="#D0D0D0"
                CornerRadius="4" />
        </HorizontalStackLayout>

        <VerticalStackLayout
            Grid.Row="1"
            Spacing="7"
            VerticalOptions="Center">
            <Label
                FontAttributes="Bold"
                FontFamily="Inter"
                FontSize="27"
                LineHeight="1.12"
                Text="Хорошего&#10;настроения и&#10;ароматного кофе!"
                TextColor="{StaticResource InkColor}" />
            <Label
                FontFamily="Inter"
                FontSize="13"
                LineHeight="1.12"
                MaxLines="3"
                Text="Мы поможем тебе понимать, когда&#10;пора подзарядиться, а когда -&#10;сделать паузу."
                TextColor="#555555" />
        </VerticalStackLayout>

        <Grid
            x:Name="StartButtonContainer"
            Grid.Row="2"
            WidthRequest="191"
            HeightRequest="46"
            HorizontalOptions="Center">
            <Border
                Padding="20,0"
                BackgroundColor="{StaticResource InkColor}"
                InputTransparent="True"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="8"
                    VerticalOptions="Center">
                    <Label
                        FontFamily="Inter"
                        FontSize="13"
                        Text="Давайте начнем"
                        TextColor="{StaticResource SurfaceColor}"
                        VerticalTextAlignment="Center" />
                    <Image
                        WidthRequest="10"
                        HeightRequest="10"
                        Aspect="AspectFit"
                        Source="more_ico.png" />
                </HorizontalStackLayout>
            </Border>

            <!-- Прозрачный нативный Button сохраняет hit area, accessibility и pressed state. -->
            <Button
                Padding="0"
                AutomationId="StartOnboardingButton"
                BackgroundColor="#01000000"
                BorderWidth="0"
                Clicked="OnStartButtonClicked"
                CornerRadius="18"
                SemanticProperties.Description="Давайте начнем, перейти к вводу имени"
                Text="" />
        </Grid>
    </Grid>
</ContentPage>
