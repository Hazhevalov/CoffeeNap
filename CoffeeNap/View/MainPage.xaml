<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoffeeNap.MainPage"
             BackgroundColor="#f5f5f5" 
             Background="#f5f5f5">

    <StackLayout>
        <!--NavBar-->
        <FlexLayout Direction="Row" 
                    JustifyContent="SpaceBetween" 
                    Wrap="NoWrap" 
                    Padding="15"
                    AlignItems="Start"
                    HeightRequest="90"
                    BackgroundColor="#fff"
                    VerticalOptions="Start">

            <HorizontalStackLayout Spacing="10">

                <!-- Кнопка профиля -->
                <Button ImageSource="profile_ico.png"
                        BackgroundColor="#000"
                        TextColor="#fff"
                        CornerRadius="100"
                        HeightRequest="56"
                        WidthRequest="56"/>

                <!-- Текст справа от кнопки -->
                <VerticalStackLayout Spacing="2">

                    <Label Text="Добро пожаловать,"
                       TextColor="#000"
                       FontSize="16" />
                    <Label Text="Mr. Kwim"
                       TextColor="#000"
                       FontAttributes="Bold"
                       FontSize="20" />

                </VerticalStackLayout>
            </HorizontalStackLayout>

            <!--Кнопка настроек-->
            <Button ImageSource="settings_ico.png"
                    BackgroundColor="#000"
                    TextColor="#fff"
                    CornerRadius="100" 
                    HeightRequest="56" 
                    WidthRequest="56" />
        </FlexLayout>

        <!--Блок Дневная норма кофеина-->
        <Border StrokeShape="30"
                Margin="10, 15">
            
            <Grid Padding="15" BackgroundColor="#000" RowSpacing="15">
                    <Grid.RowDefinitions>
                        <!-- заголовок -->
                        <RowDefinition Height="Auto"/>
                        <!-- прогресс -->
                        <RowDefinition Height="Auto"/>
                        <!-- значение -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                <Label Text="Дневная
                             норма кофеина"
                       Grid.Row="0"
                       Grid.Column="1"
                       TextColor="#fff"
                       FontSize="24"
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>


                <Button ImageSource="more_ico.png"
                        WidthRequest="56"
                        HeightRequest="56"
                        BackgroundColor="#000"
                        CornerRadius="100"
                        Grid.Row="0"
                        Grid.Column="2"/>

                <!--Прогрессбар-->
                <Grid Grid.Row="1"
                      Grid.Column="1"
                      HeightRequest="12"
                      VerticalOptions="Center"
                      Grid.ColumnSpan="1">

                    <Border BackgroundColor="#2B2B2B"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0">

                        <Grid>
                            <Border BackgroundColor="#C3F421"
                                    StrokeShape="RoundRectangle 12"
                                    HorizontalOptions="Start"
                                    WidthRequest="100"
                                    StrokeThickness="0"/>
                        </Grid>
                    </Border>
                </Grid>

                <Label Text="300мг"
                       TextColor="#fff"
                       FontSize="12"
                       Grid.Row="1"
                       Grid.Column="3"
                       VerticalOptions="Center"
                       HorizontalOptions="End"
                       FontAttributes="Bold"/>

                <Label Grid.Row="2"
                       Grid.Column="1"
                       FontAttributes="Bold"
                       TextColor="#fff">
                    
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="150 " 
                                  FontSize="38" 
                                  FontAttributes="Bold"/>

                            <Span Text="миллиграмм" 
                                  FontSize="20"
                                  FontAttributes="Bold"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Grid>
        </Border>

        <!--Блок Источник кофеина-->
        <Border StrokeShape="30"
                BackgroundColor="#fff"
                Stroke="#EAEAEA" Margin="15,0">

            <Grid Padding="15" RowSpacing="15">
                <Grid.RowDefinitions>
                    <!-- заголовок 0 -->
                    <RowDefinition Height="Auto"/>
                    <!-- значения 1 -->
                    <RowDefinition Height="Auto"/>
                    <!-- прогресс 2 -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Text="Ваш 
                             источник кофеина" 
                       Grid.Row="0"
                       Grid.Column="0"
                       Grid.RowSpan="1"
                       Grid.ColumnSpan="2"
                       TextColor="#000"
                       FontSize="24"
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>


                <Button ImageSource="more_black_ico.png"
                        WidthRequest="56"
                        HeightRequest="56"
                        BackgroundColor="#fff"
                        CornerRadius="100"
                        Grid.Row="0"
                        Grid.Column="2"/>

                <!--Второй прогрессбар-->
                <Grid Grid.Row="1"
                      Grid.Column="0"
                      VerticalOptions="Center"
                      Grid.ColumnSpan="3">

                    <Border BackgroundColor="#F4F4F4"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>

                            <Border BackgroundColor="#AAAAAA"
                                    StrokeShape="RoundRectangle 12"
                                    HorizontalOptions="Start"
                                    WidthRequest="320"
                                    Padding="5"
                                    StrokeThickness="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2">

                                <Label Text="33%"
                                       HorizontalOptions="End"
                                       TextColor="#fff"
                                       FontSize="12" />
                            </Border>

                            <Border BackgroundColor="#585858"
                                    StrokeShape="RoundRectangle 12"
                                    HorizontalOptions="Start"
                                    WidthRequest="175"
                                    Padding="5"
                                    StrokeThickness="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="1">

                                <Label Text="33%"
                                       HorizontalOptions="End"
                                       TextColor="#fff"
                                       FontSize="12"/>
                            </Border>

                            <Border BackgroundColor="#000"
                                    StrokeShape="RoundRectangle 12"
                                    HorizontalOptions="Start"
                                    WidthRequest="75"
                                    Padding="5"
                                    StrokeThickness="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="0">
                                
                                <Label Text="33%"
                                       HorizontalOptions="End"
                                       TextColor="#fff"
                                       FontSize="12" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                    <Grid ColumnSpacing="12" Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Блок 1 -->
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 100"
                                Grid.Row="2"
                                StrokeThickness="0">
                                

                            <HorizontalStackLayout Spacing="8">
                                <BoxView WidthRequest="10"
                                         HeightRequest="10"
                                         Color="#000"
                                         CornerRadius="100"
                                         VerticalOptions="Center"/>                                    


                                <Label Text="Кофе"
                                       FontSize="14"
                                       TextColor="#9E9E9E"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                        
                        <!-- Блок 2 -->
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 100"
                                Grid.Row="2"
                                StrokeThickness="0">
                               
                            <HorizontalStackLayout Spacing="8">
                                <BoxView WidthRequest="10"
                                         HeightRequest="10"
                                         Color="#585858"
                                         CornerRadius="100"
                                         VerticalOptions="Center"/>


                                <Label Text="Чай"
                                       FontSize="14"
                                       TextColor="#9E9E9E"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Блок 3 -->
                        <Border Grid.Row="2"
                                Grid.Column="2"
                                StrokeShape="100"
                                StrokeThickness="0"
                                Stroke="#fff"
                                BackgroundColor="#fff">

                            <HorizontalStackLayout Spacing="8">
                                <BoxView WidthRequest="10"
                                         HeightRequest="10"
                                         Color="#AAAAAA"
                                         CornerRadius="100"
                                         VerticalOptions="Center"/>


                                <Label Text="Энергетики"
                                       FontSize="14"
                                       TextColor="#9E9E9E"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>

                </Grid>
            </Grid>
        </Border>
    </StackLayout>
</ContentPage>
