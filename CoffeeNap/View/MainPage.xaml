<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CoffeeNap.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CoffeeNap.Controls"
    xmlns:models="clr-namespace:CoffeeNap.Models"
    xmlns:viewModels="clr-namespace:CoffeeNap.ViewModels"
    x:DataType="viewModels:MainViewModel"
    BackgroundColor="{StaticResource PageBackgroundColor}"
    SafeAreaEdges="All"
    Shell.NavBarIsVisible="False">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CollectionView
            Grid.Row="0"
            BackgroundColor="{StaticResource SurfaceColor}"
            ItemsSource="{Binding Consumptions}"
            SelectionMode="None"
            VerticalScrollBarVisibility="Never">

            <CollectionView.Header>
                <VerticalStackLayout Spacing="0">
                    <VerticalStackLayout
                        Padding="0,0,0,12"
                        Spacing="0"
                        BackgroundColor="{StaticResource PageBackgroundColor}">

                        <Grid
                            HeightRequest="86"
                            Padding="10,13"
                            BackgroundColor="{StaticResource SurfaceColor}"
                            ColumnSpacing="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                WidthRequest="44"
                                HeightRequest="44"
                                Padding="11"
                                BackgroundColor="{StaticResource InkColor}"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22" />
                                </Border.StrokeShape>
                                <Image Source="profile_ico.png" Aspect="AspectFit" />
                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="1"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="Inter"
                                    FontSize="12"
                                    Text="Добро пожаловать,"
                                    TextColor="{StaticResource SecondaryTextColor}" />
                                <Label
                                    FontFamily="Inter"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    Text="Mr. Kwim"
                                    TextColor="{StaticResource InkColor}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="2"
                                WidthRequest="44"
                                HeightRequest="44"
                                Padding="11"
                                VerticalOptions="Center"
                                BackgroundColor="{StaticResource InkColor}"
                                Command="{Binding OpenSettingsCommand}"
                                CornerRadius="22"
                                ImageSource="settings_ico.png" />
                        </Grid>

                        <Border
                            Margin="8,10,8,10"
                            HeightRequest="138"
                            Padding="13"
                            BackgroundColor="{StaticResource InkColor}"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow
                                    Brush="{StaticResource CardShadowBrush}"
                                    Offset="0,2"
                                    Opacity="0.16"
                                    Radius="6" />
                            </Border.Shadow>

                            <Grid RowSpacing="7">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        FontFamily="Inter"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        LineHeight="0.9"
                                        Text="Дневная&#10;норма кофеина"
                                        TextColor="{StaticResource SurfaceColor}" />
                                    <Image
                                        Grid.Column="1"
                                        WidthRequest="15"
                                        HeightRequest="15"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        Source="more_ico.png" />
                                </Grid>

                                <Grid Grid.Row="1" ColumnSpacing="7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar
                                        HeightRequest="8"
                                        VerticalOptions="Center"
                                        BackgroundColor="{StaticResource ProgressTrackColor}"
                                        Progress="{Binding DailyProgress}"
                                        ProgressColor="{StaticResource ProgressAccentColor}" />
                                    <Label
                                        Grid.Column="1"
                                        FontFamily="Inter"
                                        FontSize="10"
                                        Text="{Binding DailyCaffeineLimit, StringFormat='{0:0}мг'}"
                                        TextColor="{StaticResource MutedTextColor}"
                                        VerticalOptions="Center" />
                                </Grid>

                                <HorizontalStackLayout
                                    Grid.Row="2"
                                    Spacing="7"
                                    VerticalOptions="End">
                                    <Label
                                        FontFamily="Inter"
                                        FontSize="31"
                                        FontAttributes="Bold"
                                        Text="{Binding CurrentCaffeine, StringFormat='{0:0}'}"
                                        TextColor="{StaticResource SurfaceColor}" />
                                    <Label
                                        Margin="0,0,0,4"
                                        FontFamily="Inter"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        Text="миллиграмм"
                                        TextColor="{StaticResource SurfaceColor}"
                                        VerticalOptions="End" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>

                        <Border
                            Margin="8,0"
                            HeightRequest="115"
                            Padding="13,11"
                            BackgroundColor="{StaticResource SurfaceColor}"
                            Stroke="{StaticResource DividerColor}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow
                                    Brush="{StaticResource CardShadowBrush}"
                                    Offset="0,1"
                                    Opacity="0.08"
                                    Radius="4" />
                            </Border.Shadow>

                            <Grid RowSpacing="7">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="20" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        FontFamily="Inter"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        LineHeight="0.9"
                                        Text="Ваши&#10;источники кофеина"
                                        TextColor="{StaticResource InkColor}" />
                                    <Image
                                        Grid.Column="1"
                                        WidthRequest="14"
                                        HeightRequest="14"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        Source="more_black_ico.png" />
                                </Grid>

                                <Grid Grid.Row="1" ColumnSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding CoffeeSource.SegmentWidth}" />
                                        <ColumnDefinition Width="{Binding TeaSource.SegmentWidth}" />
                                        <ColumnDefinition Width="{Binding EnergyDrinkSource.SegmentWidth}" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        BackgroundColor="{Binding CoffeeSource.Color}"
                                        StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10,0,0,10" />
                                        </Border.StrokeShape>
                                        <Label
                                            FontFamily="Inter"
                                            FontSize="9"
                                            HorizontalTextAlignment="Center"
                                            Text="{Binding CoffeeSource.PercentageDisplay}"
                                            TextColor="{StaticResource SurfaceColor}"
                                            VerticalTextAlignment="Center" />
                                    </Border>

                                    <Border
                                        Grid.Column="1"
                                        BackgroundColor="{Binding TeaSource.Color}"
                                        StrokeThickness="0">
                                        <Label
                                            FontFamily="Inter"
                                            FontSize="9"
                                            HorizontalTextAlignment="Center"
                                            Text="{Binding TeaSource.PercentageDisplay}"
                                            TextColor="{StaticResource SurfaceColor}"
                                            VerticalTextAlignment="Center" />
                                    </Border>

                                    <Border
                                        Grid.Column="2"
                                        BackgroundColor="{Binding EnergyDrinkSource.Color}"
                                        StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="0,10,10,0" />
                                        </Border.StrokeShape>
                                        <Label
                                            FontFamily="Inter"
                                            FontSize="9"
                                            HorizontalTextAlignment="Center"
                                            Text="{Binding EnergyDrinkSource.PercentageDisplay}"
                                            TextColor="{StaticResource SurfaceColor}"
                                            VerticalTextAlignment="Center" />
                                    </Border>
                                </Grid>

                                <HorizontalStackLayout
                                    Grid.Row="2"
                                    Spacing="13"
                                    BindableLayout.ItemsSource="{Binding SourceStats}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:CaffeineSourceStat">
                                            <HorizontalStackLayout Spacing="5">
                                                <BoxView
                                                    WidthRequest="8"
                                                    HeightRequest="8"
                                                    BackgroundColor="{Binding Color}"
                                                    CornerRadius="4"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    FontFamily="Inter"
                                                    FontSize="10"
                                                    Text="{Binding Name}"
                                                    TextColor="{StaticResource MutedTextColor}"
                                                    VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Border
                        Padding="10,6,10,4"
                        BackgroundColor="{StaticResource SurfaceColor}"
                        StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20,20,0,0" />
                        </Border.StrokeShape>
                        <Grid RowSpacing="7">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="7" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <BoxView
                                WidthRequest="42"
                                HeightRequest="4"
                                HorizontalOptions="Center"
                                BackgroundColor="{StaticResource InkColor}"
                                CornerRadius="2" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="26" />
                                </Grid.ColumnDefinitions>
                                <Label
                                    FontFamily="Inter"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    Text="Ваши употребления"
                                    TextColor="{StaticResource InkColor}" />
                                <Border
                                    Grid.Column="1"
                                    WidthRequest="18"
                                    HeightRequest="18"
                                    HorizontalOptions="End"
                                    BackgroundColor="Transparent"
                                    Stroke="{StaticResource InkColor}"
                                    StrokeThickness="2"
                                    VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="9" />
                                    </Border.StrokeShape>
                                    <Label
                                        Margin="0,-1,0,0"
                                        FontFamily="Inter"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        Text="i"
                                        TextColor="{StaticResource InkColor}"
                                        VerticalTextAlignment="Center" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CaffeineConsumption">
                    <Border
                        Margin="10,3"
                        HeightRequest="64"
                        Padding="10"
                        BackgroundColor="{StaticResource SurfaceColor}"
                        Stroke="{StaticResource DividerColor}"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow
                                Brush="{StaticResource CardShadowBrush}"
                                Offset="0,1"
                                Opacity="0.06"
                                Radius="3" />
                        </Border.Shadow>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                WidthRequest="44"
                                HeightRequest="44"
                                Padding="10"
                                BackgroundColor="{Binding IconBackground}"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22" />
                                </Border.StrokeShape>
                                <Image Source="{Binding Icon}" Aspect="AspectFit" />
                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="1"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="Inter"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1"
                                    Text="{Binding Name}"
                                    TextColor="{StaticResource InkColor}" />
                                <Label
                                    FontFamily="Inter"
                                    FontSize="11"
                                    Text="{Binding RelativeTime}"
                                    TextColor="{StaticResource MutedTextColor}" />
                            </VerticalStackLayout>

                            <Label
                                Grid.Column="2"
                                Margin="4,0,0,0"
                                FontFamily="Inter"
                                FontSize="16"
                                FontAttributes="Bold"
                                Text="{Binding CaffeineDisplay}"
                                TextColor="{StaticResource InkColor}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="12" BackgroundColor="{StaticResource SurfaceColor}" />
            </CollectionView.Footer>
        </CollectionView>

        <controls:BottomNavigationBar
            Grid.Row="1"
            AddCommand="{Binding OpenAddConsumptionCommand}"
            CalendarCommand="{Binding OpenCalendarCommand}" />
    </Grid>
</ContentPage>
