<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <!-- Entitlements declare capabilities permitted by the macOS sandbox. -->
    <dict>
        <!-- Sandboxing is required for Mac Catalyst distribution in the Mac App Store. -->
        <key>com.apple.security.app-sandbox</key>
        <true/>
        <!-- Allows outbound network connections from the sandbox. -->
        <key>com.apple.security.network.client</key>
        <true/>
    </dict>
</plist>

