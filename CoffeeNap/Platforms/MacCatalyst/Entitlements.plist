<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <!-- Entitlements объявляют возможности, разрешённые песочницей macOS. -->
    <dict>
        <!-- Песочница обязательна для публикации Mac Catalyst в Mac App Store. -->
        <key>com.apple.security.app-sandbox</key>
        <true/>
        <!-- Разрешает исходящие сетевые соединения из песочницы. -->
        <key>com.apple.security.network.client</key>
        <true/>
    </dict>
</plist>

