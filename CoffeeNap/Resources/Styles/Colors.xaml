<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Общая палитра MAUI. Android splash-тема также использует нативный colors.xml. -->

    <!-- Нейтральные и вспомогательные цвета светлой/тёмной темы. -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <!-- Семантическая палитра актуального главного экрана CoffeeNap. -->
    <Color x:Key="PageBackgroundColor">#F4F4F4</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="InkColor">#080808</Color>
    <Color x:Key="SecondaryTextColor">#3E3E3E</Color>
    <Color x:Key="MutedTextColor">#A2A2A2</Color>
    <Color x:Key="DividerColor">#E7E7E7</Color>
    <Color x:Key="ValidationErrorColor">#C62828</Color>
    <Color x:Key="ProgressTrackColor">#303030</Color>
    <Color x:Key="ProgressAccentColor">#B7FF17</Color>
    
    <!-- Цвета четырёх диапазонов заполнения дневной нормы. -->
    <Color x:Key="CaffeineProgressLow">#B7FF17</Color>
    <Color x:Key="CaffeineProgressMedium">#FFD60A</Color>
    <Color x:Key="CaffeineProgressHigh">#FF9500</Color>
    <Color x:Key="CaffeineProgressLimit">#FF3B30</Color>
    
    <!--Цвета для карточек в Quizz-->
    <Color x:Key="CaffeeIcoFill">#000000</Color>
    <Color x:Key="EnergyDrinkIcoFill">#535353</Color>
    <Color x:Key="TeaIcoFill">#939393</Color>
    <SolidColorBrush x:Key="CardShadowBrush" Color="#22000000" />
</ResourceDictionary>
